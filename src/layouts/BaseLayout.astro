---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StarField from '../components/StarField.astro';
import { documentTitle, site, type DocumentPage } from '../site.config';
import { absoluteUrl, pathForLocale, withBase } from '../lib/url';
import { localeMeta, type Locale } from '../i18n';

interface Props {
  /** The localized kind of page, used to build the browser-tab title. */
  page: DocumentPage;
  /** Required for theme pages; the already-localized theme name. */
  subject?: string;
  description?: string;
  /** Which language this route renders. */
  lang: Locale;
  ogImage?: string;
}

const { page, subject, description, lang, ogImage } = Astro.props;
const meta = localeMeta[lang];
const fullTitle = documentTitle(lang, page, subject);
const canonical = absoluteUrl(Astro.url.pathname);
const pageDescription = description ?? site.description[lang];
const socialImage = ogImage ?? (lang === 'zh' ? '/og-default.png' : '/og-en.png');

// the same page in the other language - every route exists in both
const alternateZh = absoluteUrl(pathForLocale(Astro.url.pathname, 'zh'));
const alternateEn = absoluteUrl(pathForLocale(Astro.url.pathname, 'en'));
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={withBase('/favicon.svg')} />
    <link rel="alternate" hreflang={localeMeta.zh.hreflang} href={alternateZh} />
    <link rel="alternate" hreflang={localeMeta.en.hreflang} href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateZh} />
    <meta name="theme-color" content="#080D1C" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(socialImage)} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <StarField />
    <SiteHeader lang={lang} showSearch={page !== 'themes'} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style is:global>
  /* the sky sits behind everything; page content stacks above it */
  .site-header,
  main,
  .site-footer {
    position: relative;
    z-index: 1;
  }
</style>

