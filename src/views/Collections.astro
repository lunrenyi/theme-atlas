---
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionMotif from '../components/CollectionMotif.astro';
import ThemeCard from '../components/ThemeCard.astro';
import ThemeLibrary from '../components/ThemeLibrary.astro';
import { getCollections, getThemes } from '../lib/content';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const collections = getCollections(lang);
const themes = getThemes(lang);
---

<BaseLayout
  title={t(lang, 'collections.title')}
  description={t(lang, 'collections.lede')}
  lang={lang}
>
  <section class="page-head">
    <div class="wrap wrap--wide">
      <p class="eyebrow eyebrow--gold">{t(lang, 'collections.eyebrow')}</p>
      <h1 class="page-head__title">{t(lang, 'collections.title')}</h1>
      <p class="lede">{t(lang, 'collections.lede')}</p>
    </div>
  </section>

  {
    collections.map((collection, index) => {
      const list = themes.filter((t) => t.collection === collection.id);
      return (
        <section class="section collection" id={collection.id} style={'--tone:' + collection.accent}>
          <div class="wrap wrap--wide">
            <div class="collection__head">
              <div class="collection__intro">
                <span class="collection__index mono">
                  {t(lang, 'collections.index', { n: String(index + 1).padStart(2, '0') })}
                </span>
                <h2 class="collection__title">{collection.title}</h2>
                <p class="collection__en mono">{collection.code}</p>
                <p class="collection__tagline">{collection.tagline}</p>
                <p class="collection__desc">{collection.description}</p>
                <p class="collection__count mono">
                  {t(lang, 'series.themes', { n: list.length })}
                </p>
              </div>
              <CollectionMotif
                variant={collection.motif}
                accent={collection.accent}
                accentAlt={collection.accentAlt}
                class="collection__motif"
                lang={lang}
              />
            </div>

            <div class="collection__grid">
              {list.map((theme) => (
                <ThemeCard theme={theme} lang={lang} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section" id="all">
    <div class="wrap wrap--wide">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--gold">{t(lang, 'collections.allEyebrow')}</p>
          <h2 class="section-head__title">{t(lang, 'collections.allTitle')}</h2>
        </div>
        <p class="section-head__meta">{themes.length} THEMES</p>
      </div>
      <ThemeLibrary themes={themes} lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(48px, 7vw, 100px) clamp(16px, 2vw, 28px);
    border-bottom: 1px solid var(--orbit-faint);
  }

  .page-head__title {
    font-size: var(--step-4);
    margin: 14px 0 18px;
  }

  .collection {
    border-bottom: 1px solid var(--orbit-faint);
  }

  .collection__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .collection__index {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--tone);
  }

  .collection__title {
    font-size: var(--step-3);
    margin-top: 10px;
  }

  .collection__en {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-top: 6px;
  }

  .collection__tagline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-top: 16px;
    line-height: 1.45;
    color: var(--text);
  }

  .collection__desc {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.85;
    margin-top: 12px;
    max-width: 52ch;
  }

  .collection__count {
    margin-top: 16px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-3);
  }

  :global(.collection__motif) {
    width: 100%;
    height: auto;
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(288px, 1fr));
    gap: 22px;
  }

  @media (max-width: 820px) {
    .collection__head {
      grid-template-columns: 1fr;
    }
  }
</style>
