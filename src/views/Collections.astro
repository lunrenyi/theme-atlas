---
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionMotif from '../components/CollectionMotif.astro';
import GameWorldCollection from '../components/GameWorldCollection.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { getCollections, getThemesByCollection } from '../lib/content';
import { localePath } from '../lib/url';
import { seriesNumber, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const collections = getCollections(lang);
const collectionGroups = collections.map((collection) => ({
  collection,
  themes: getThemesByCollection(collection.id, lang),
}));
---

<BaseLayout
  page="collections"
  description={t(lang, 'collections.lede')}
  lang={lang}
>
  <section class="page-head">
    <div class="wrap wrap--wide">
      <p class="eyebrow eyebrow--gold">{t(lang, 'collections.eyebrow')}</p>
      <h1 class="page-head__title">{t(lang, 'collections.title')}</h1>
      <p class="lede">{t(lang, 'collections.lede')}</p>
    </div>
  </section>

  {
    collectionGroups.map(({ collection, themes: list }, index) => {
      if (collection.id === 'game') {
        return <GameWorldCollection collection={collection} themes={list} lang={lang} />;
      }

      return (
        <section
          class="section collection"
          id={collection.id}
          data-collection-section={collection.id}
          data-theme-count={list.length}
          style={'--tone:' + collection.accent}
        >
          <div class="wrap wrap--wide">
            <div class="collection__head">
              <div class="collection__intro">
                <span class="collection__index mono">
                  {t(lang, 'collections.index', { n: seriesNumber(lang, index) })}
                </span>
                <h2 class="collection__title">{collection.title}</h2>
                {collection.code && <p class="collection__en mono">{collection.code}</p>}
                <p class="collection__tagline">{collection.tagline}</p>
                <p class="collection__desc">{collection.description}</p>
                <div class="collection__meta">
                  <p class="collection__count mono">
                    {t(lang, 'series.themes', { n: list.length })}
                  </p>
                  <a class="collection__browse" href={localePath('/themes/?c=' + collection.id, lang)}>
                    {t(lang, 'collections.browseSeries')} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
              <CollectionMotif
                variant={collection.motif}
                accent={collection.accent}
                accentAlt={collection.accentAlt}
                class="collection__motif"
                lang={lang}
              />
            </div>

            <div class="collection__grid">
              {list.map((theme) => (
                <ThemeCard theme={theme} variant="collection" lang={lang} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(48px, 7vw, 100px) clamp(16px, 2vw, 28px);
    border-bottom: 1px solid var(--orbit-faint);
  }

  .page-head__title {
    font-size: var(--step-4);
    margin: 14px 0 18px;
  }

  .collection {
    border-bottom: 1px solid var(--orbit-faint);
  }

  .collection__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .collection__index {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--tone);
  }

  .collection__title {
    font-size: var(--step-3);
    margin-top: 10px;
  }

  .collection__en {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-top: 6px;
  }

  .collection__tagline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-top: 16px;
    line-height: 1.45;
    color: var(--text);
  }

  .collection__desc {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.85;
    margin-top: 12px;
    max-width: 52ch;
  }

  .collection__count {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-3);
  }

  .collection__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 16px;
  }

  .collection__browse {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--orbit);
    padding-bottom: 2px;
  }

  .collection__browse:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  :global(.collection__motif) {
    width: 100%;
    height: auto;
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  @media (max-width: 1180px) {
    .collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .collection__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .collection__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
