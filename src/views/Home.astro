---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarMap from '../components/StarMap.astro';
import SeriesPanel from '../components/SeriesPanel.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { getCollections, getFeaturedThemes, getThemes, getThemesByCollection } from '../lib/content';
import { site } from '../site.config';
import { localePath } from '../lib/url';
import { spaceBefore, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const collections = getCollections(lang);
const themes = getThemes(lang);
const featured = getFeaturedThemes(lang).slice(0, 3);
const total = themes.length;
const sample = themes[0];
---

<BaseLayout page="home" description={site.description[lang]} lang={lang}>
  <!-- ============================ hero ============================ -->
  <section class="hero">
    <div class="wrap wrap--wide">
      <div class="hero__kicker">
        <span class="eyebrow eyebrow--gold">{site.edition[lang]}</span>
        <span class="eyebrow hero__kicker-mid">{t(lang, 'hero.kicker')}</span>
        <span class="eyebrow hero__kicker-end">
          {t(lang, 'hero.counts', {
            series: String(collections.length).padStart(2, '0'),
            themes: String(total).padStart(3, '0'),
          })}
        </span>
      </div>

      <div class="hero__grid">
        <div class="hero__lead">
          <h1 class="display hero__title">
            {t(lang, 'hero.title1')}<br />{t(lang, 'hero.title2')}{spaceBefore(lang)}<em data-lang={lang}>{t(lang, 'hero.titleEm')}</em>
          </h1>
          <p class="lede hero__text">{t(lang, 'hero.lede')}</p>
          <div class="hero__actions">
            <a class="btn btn--solid" href={localePath('/themes/', lang)}>
              {t(lang, 'hero.ctaPrimary')}
            </a>
            <a class="hero__more" href={localePath('/collections', lang)}>
              {t(lang, 'hero.ctaSecondary')} <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="hero__readout">
            <div>
              <dt class="eyebrow">{t(lang, 'hero.readoutSeries')}</dt>
              <dd>{collections.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">{t(lang, 'hero.readoutThemes')}</dt>
              <dd>{total}</dd>
            </div>
            <div>
              <dt class="eyebrow">{t(lang, 'hero.readoutRoles')}</dt>
              <dd>7</dd>
            </div>
            <div>
              <dt class="eyebrow">{t(lang, 'hero.readoutExport')}</dt>
              <dd class="hero__readout-sm">{t(lang, 'hero.readoutExportValue')}</dd>
            </div>
          </dl>
        </div>

        <div class="hero__chart">
          <StarMap collections={collections} lang={lang} />
          <p class="hero__chart-note mono">
            {t(lang, 'hero.chartNote', { count: collections.length })}
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap wrap--wide"><div class="scale" aria-hidden="true"></div></div>

  <!-- ======================== series nav ========================== -->
  <section class="section series-section" id="series">
    <div class="wrap wrap--wide">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--gold">
            <span class="index">01</span> {t(lang, 'section.seriesEyebrow')}
          </p>
          <h2 class="section-head__title">{t(lang, 'section.seriesTitle')}</h2>
        </div>
        <p class="section-head__meta">
          {t(lang, 'section.seriesMeta', { count: collections.length })}
        </p>
      </div>

      <p class="section-lede">{t(lang, 'section.seriesLede')}</p>

      <div class="series-grid">
        {
          collections.map((collection, i) => (
            <SeriesPanel
              collection={collection}
              themes={getThemesByCollection(collection.id, lang)}
              index={i}
              lang={lang}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== featured ========================== -->
  <section class="section featured">
    <div class="wrap wrap--wide">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--gold">
            <span class="index">02</span> {t(lang, 'section.featuredEyebrow')}
          </p>
          <h2 class="section-head__title">{t(lang, 'section.featuredTitle')}</h2>
        </div>
        <p class="section-head__meta">{t(lang, 'section.featuredMeta')}</p>
      </div>

      <div class="featured__list">
        {featured.map((theme) => <ThemeCard theme={theme} variant="featured" lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- ======================= all themes CTA ======================= -->
  <section class="section browse-invite">
    <div class="wrap wrap--wide">
      <a class="browse-invite__link" href={localePath('/themes/', lang)}>
        <span class="browse-invite__copy">
          <span class="eyebrow eyebrow--gold">{t(lang, 'section.browseEyebrow')}</span>
          <span class="browse-invite__title">{t(lang, 'section.browseTitle')}</span>
          <span class="browse-invite__lede">{t(lang, 'section.browseLede')}</span>
          <span class="browse-invite__action">
            {t(lang, 'section.browseAll', { count: total })} <span aria-hidden="true">→</span>
          </span>
        </span>
        <svg class="browse-invite__orbit" viewBox="0 0 300 190" aria-hidden="true" fill="none">
          <ellipse cx="158" cy="96" rx="112" ry="38" transform="rotate(-14 158 96)" stroke="#344363"></ellipse>
          <ellipse cx="158" cy="96" rx="75" ry="58" transform="rotate(38 158 96)" stroke="#344363" opacity="0.55"></ellipse>
          <circle cx="158" cy="96" r="5" fill="#DCC38B"></circle>
          <circle cx="250" cy="59" r="3.5" fill="#76D8DF"></circle>
          <circle cx="91" cy="151" r="2.6" fill="#9885FF"></circle>
          <circle cx="35" cy="32" r="1.5" fill="#EAF0FF" opacity="0.65"></circle>
        </svg>
      </a>
    </div>
  </section>

  <!-- ========================= capabilities ======================= -->
  <section class="section capabilities">
    <div class="wrap wrap--wide">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--gold">
            <span class="index">03</span> {t(lang, 'section.capabilityEyebrow')}
          </p>
          <h2 class="section-head__title">{t(lang, 'section.capabilityTitle')}</h2>
        </div>
        <p class="section-head__meta">CSS / JSON</p>
      </div>

      <div class="capabilities__body">
        <p>{t(lang, 'section.capabilityLede')}</p>
        <div class="capabilities__actions">
          <a class="btn btn--ghost btn--sm" href={localePath('/theme/' + sample.slug, lang)}>
            {t(lang, 'section.capabilityDetail')}
          </a>
          <a class="hero__more" href={localePath('/themes/', lang)}>
            {t(lang, 'hero.ctaPrimary')} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    padding-top: clamp(26px, 3.6vw, 52px);
    padding-bottom: clamp(36px, 5vw, 72px);
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--orbit-faint);
    margin-bottom: clamp(26px, 3.4vw, 46px);
  }

  .hero__kicker-end {
    margin-left: auto;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    gap: clamp(24px, 3vw, 52px);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(2.5rem, 4.9vw, 4.7rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__title em {
    font-style: italic;
    color: var(--gold);
    white-space: nowrap;
  }

  /* Chinese display type is never slanted — the accent colour carries it. */
  .hero__title em[data-lang='zh'] {
    font-style: normal;
  }

  .hero__text {
    margin-top: clamp(18px, 2.2vw, 26px);
    max-width: 34em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: clamp(22px, 2.6vw, 30px);
  }

  .hero__more {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-2);
    border-bottom: 1px solid var(--orbit);
    padding-bottom: 3px;
  }

  .hero__more:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  /* instrument read-out under the deck */
  .hero__readout {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: clamp(26px, 3.4vw, 40px) 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--orbit-faint);
  }

  .hero__readout dt {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
  }

  .hero__readout dd {
    margin: 5px 0 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .hero__readout .hero__readout-sm {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--glow);
    padding-top: 4px;
  }

  .hero__chart {
    position: relative;
  }

  .hero__chart-note {
    margin-top: 10px;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
    text-align: center;
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__chart {
      order: 2;
      max-width: 480px;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 680px) {
    .hero__kicker-mid {
      display: none;
    }

    .hero__kicker {
      gap: 12px;
    }

    .hero__kicker-end {
      letter-spacing: 0.12em;
    }

    .hero__readout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  /* ---------------- series nav ---------------- */
  .section-lede {
    max-width: 52ch;
    margin: -clamp(12px, 1.6vw, 22px) 0 clamp(22px, 2.6vw, 34px);
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.72;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 44px);
  }

  @media (max-width: 1180px) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- featured ---------------- */
  .featured__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ---------------- browse invitation ---------------- */
  .browse-invite {
    padding-block: clamp(12px, 2vw, 24px);
  }

  .browse-invite__link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.54fr);
    align-items: center;
    gap: 24px;
    overflow: hidden;
    padding: clamp(24px, 3.2vw, 42px);
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius);
    background:
      linear-gradient(100deg, rgb(17 27 53 / 0.72), rgb(8 13 28 / 0.24)),
      radial-gradient(circle at 86% 30%, rgb(118 216 223 / 0.08), transparent 34%);
    text-decoration: none;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .browse-invite__link:hover,
  .browse-invite__link:focus-visible {
    border-color: var(--gold);
  }

  .browse-invite__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .browse-invite__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--text);
  }

  .browse-invite__lede {
    max-width: 50ch;
    color: var(--text-2);
    line-height: 1.7;
  }

  .browse-invite__action {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--glow);
  }

  .browse-invite__orbit {
    width: 100%;
    height: auto;
    opacity: 0.9;
  }

  /* ---------------- capabilities ---------------- */
  .capabilities__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(24px, 4vw, 64px);
    padding-top: 6px;
  }

  .capabilities__body > p {
    max-width: 62ch;
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.82;
  }

  .capabilities__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 22px;
  }

  @media (max-width: 820px) {
    .browse-invite__link {
      grid-template-columns: 1fr;
    }

    .browse-invite__orbit {
      display: none;
    }

    .capabilities__body {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
