---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaletteHud from '../components/PaletteHud.astro';
import PalettePanel from '../components/PalettePanel.astro';
import PreviewPanel from '../components/PreviewPanel.astro';
import ContrastAudit from '../components/ContrastAudit.astro';
import Prose from '../components/Prose.astro';
import ThemePlate from '../components/ThemePlate.astro';
import type { Theme } from '../data/types';
import { getCollectionById, getThemeNeighbours } from '../lib/content';
import { localePath } from '../lib/url';
import { t, type Locale } from '../i18n';

interface Props {
  theme: Theme;
  lang: Locale;
}

const { theme, lang } = Astro.props;
const collection = getCollectionById(theme.collection, lang);
const { prev, next } = getThemeNeighbours(theme.slug, lang);

const statusMap = {
  verified: { label: t(lang, 'card.statusVerified'), tone: 'ok' },
  interpretation: { label: t(lang, 'card.statusInterpretationFull'), tone: 'fan' },
  draft: { label: t(lang, 'card.statusDraft'), tone: 'warn' },
} as const;
const status = statusMap[theme.status];

const sourceTypeLabel: Record<string, string> = {
  book: t(lang, 'detail.sourceBook'),
  article: t(lang, 'detail.sourceArticle'),
  link: t(lang, 'detail.sourceLink'),
  pending: t(lang, 'detail.sourcePending'),
};
---

<BaseLayout title={theme.title} description={theme.description} lang={lang}>
  <article class="detail" data-theme-slug={theme.slug} data-palette-panel>
    <!-- the theme's own colours, full bleed: the page opens with its palette -->
    <div class="specimen" aria-hidden="true">
      {
        theme.palette.map((c) => (
          <span class="specimen__chip" style={'--swatch:' + c.hex} title={c.name + ' ' + c.hex} />
        ))
      }
    </div>

    <div class="wrap wrap--wide">
      <nav class="crumbs" aria-label={t(lang, 'detail.back')}>
        <a href={localePath('/#themes', lang)}>← {t(lang, 'detail.back')}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
        <a href={localePath('/collections#' + collection.id, lang)}>{collection.title}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
        <span class="crumbs__current mono">{theme.slug}</span>
      </nav>

      <div class="detail__grid">
        <!-- ------------------------------ story ------------------------------ -->
        <div class="detail__story">
          <!-- the palette runs alongside the story as a colour spine -->
          <div class="detail__spine" aria-hidden="true">
            {theme.palette.map((c) => <span style={'--tone:' + c.hex}></span>)}
          </div>

          <div class="detail__story-body">
            <header class="detail__header">
              <div class="detail__badges">
                <a class="badge badge--collection" href={localePath('/collections#' + collection.id, lang)}>
                  <span class="badge__dot" style={'--tone:' + collection.accent} aria-hidden="true"></span>
                  {collection.title}
                </a>
                <span class:list={['tag', 'tag--' + status.tone]}>{status.label}</span>
              </div>

              <h1 class="detail__title">{theme.title}</h1>
              <p class="detail__subtitle">{theme.subtitle}</p>
              <p class="detail__description">{theme.description}</p>

              <ul class="detail__tags">
                {theme.tags.map((tag) => <li class="mono">{tag}</li>)}
              </ul>
            </header>

            <ThemePlate theme={theme} lang={lang} />

            <section class="prose-block" aria-labelledby="story-heading">
              <h2 id="story-heading" class="prose-block__heading">
                <span class="prose-block__index mono">01</span>{t(lang, 'detail.story')}
              </h2>
              <Prose text={theme.story} palette={theme.palette} />
            </section>

            <section class="prose-block" aria-labelledby="inspiration-heading">
              <h2 id="inspiration-heading" class="prose-block__heading">
                <span class="prose-block__index mono">02</span>{t(lang, 'detail.inspiration')}
              </h2>
              <Prose text={theme.inspiration} palette={theme.palette} />
            </section>

            <section class="prose-block" aria-labelledby="rationale-heading">
              <h2 id="rationale-heading" class="prose-block__heading">
                <span class="prose-block__index mono">03</span>{t(lang, 'detail.rationale')}
              </h2>
              <Prose text={theme.designRationale} palette={theme.palette} />
            </section>

            <section class="prose-block" aria-labelledby="sources-heading">
              <h2 id="sources-heading" class="prose-block__heading">
                <span class="prose-block__index mono">04</span>{t(lang, 'detail.sources')}
              </h2>
              <ul class="sources">
                {
                  theme.sources.map((source) => (
                    <li class="source">
                      <span class:list={['source__type', 'source__type--' + source.type]}>
                        {sourceTypeLabel[source.type] ?? source.type}
                      </span>
                      <span class="source__body">
                        <span class="source__title">
                          {source.url ? (
                            <a href={source.url} rel="noopener noreferrer" target="_blank">
                              {source.title}
                              <span class="source__ext" aria-hidden="true">↗</span>
                            </a>
                          ) : (
                            source.title
                          )}
                        </span>
                        {source.detail && <span class="source__detail">{source.detail}</span>}
                        {source.note && <span class="source__note">{source.note}</span>}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="prose-block" aria-labelledby="credits-heading">
              <h2 id="credits-heading" class="prose-block__heading">
                <span class="prose-block__index mono">05</span>{t(lang, 'detail.credits')}
              </h2>
              <dl class="credits">
                {
                  [
                    [t(lang, 'detail.creditPalette'), theme.credits.palette],
                    [t(lang, 'detail.creditStory'), theme.credits.story],
                    [t(lang, 'detail.creditGraphics'), theme.credits.graphics],
                    [t(lang, 'detail.creditLicence'), theme.credits.license],
                    [t(lang, 'detail.creditImage'), theme.credits.imageLicence],
                    [t(lang, 'detail.creditDisclaimer'), theme.credits.disclaimer],
                  ]
                    .filter((row) => row[1])
                    .map(([label, value]) => (
                      <div class="credits__row">
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))
                }
              </dl>
              {
                theme.credits.disclaimer && (
                  <p class="prose-block__aside">{t(lang, 'detail.disclaimerAside')}</p>
                )
              }
            </section>

            <nav class="switcher" aria-label={t(lang, 'detail.keepBrowsing')}>
              <p class="switcher__label eyebrow">{t(lang, 'detail.keepBrowsing')}</p>
              <div class="switcher__row">
                {
                  prev && (
                    <a class="switcher__item" href={localePath('/theme/' + prev.slug, lang)}>
                      <span class="switcher__band" aria-hidden="true">
                        {prev.palette.map((c) => (
                          <i style={'--tone:' + c.hex} />
                        ))}
                      </span>
                      <span class="switcher__text">
                        <span class="switcher__dir">← {t(lang, 'detail.previous')}</span>
                        <span class="switcher__name">{prev.title}</span>
                      </span>
                    </a>
                  )
                }
                {
                  next && (
                    <a class="switcher__item switcher__item--next" href={localePath('/theme/' + next.slug, lang)}>
                      <span class="switcher__text">
                        <span class="switcher__dir">{t(lang, 'detail.next')} →</span>
                        <span class="switcher__name">{next.title}</span>
                      </span>
                      <span class="switcher__band" aria-hidden="true">
                        {next.palette.map((c) => (
                          <i style={'--tone:' + c.hex} />
                        ))}
                      </span>
                    </a>
                  )
                }
              </div>
              <a class="switcher__all" href={localePath('/#themes', lang)}>
                {t(lang, 'detail.backToAll')}
              </a>
            </nav>
          </div>
        </div>

        <!-- ------------------------------ console ---------------------------- -->
        <aside class="detail__rail">
          <div class="detail__console">
            <div class="detail__console-body">
              <PaletteHud theme={theme} lang={lang} />
              <PalettePanel theme={theme} lang={lang} />
              <PreviewPanel theme={theme} lang={lang} />
              <ContrastAudit theme={theme} lang={lang} />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    padding-top: 0;
  }

  .specimen {
    display: flex;
    height: clamp(44px, 5vw, 72px);
  }

  .specimen__chip {
    flex: 1 1 0;
    background: var(--swatch);
    box-shadow: inset 0 0 0 0.5px rgb(128 128 128 / 0.22);
  }

  .crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 20px 0 22px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--gold);
  }

  .crumbs__sep {
    opacity: 0.45;
  }

  .crumbs__current {
    color: var(--text-2);
  }

  .detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 3.6vw, 60px);
    align-items: stretch;
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  /* ---------------- story column ---------------- */
  .detail__story {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: stretch;
  }

  /* the palette as a spine running the full height of the story */
  .detail__spine {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .detail__spine span {
    flex: 1 1 0;
    min-height: 12px;
    background: var(--tone);
    box-shadow: inset 0 0 0 0.5px rgb(128 128 128 / 0.2);
  }

  .detail__story-body {
    min-width: 0;
  }

  .detail__header {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--orbit-faint);
    margin-bottom: 28px;
  }

  .detail__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    text-decoration: none;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }

  .badge--collection:hover {
    color: var(--text);
    border-color: var(--orbit);
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
    flex: none;
  }

  .detail__title {
    font-size: var(--step-4);
    line-height: 1.08;
    color: var(--text);
  }

  .detail__subtitle {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-2);
    margin-top: 14px;
    line-height: 1.5;
  }

  .detail__description {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.8;
    margin-top: 16px;
    max-width: 44ch;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin-top: 20px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  .detail__tags li {
    border: 1px solid var(--orbit-faint);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  .prose-block {
    margin-top: 34px;
  }

  .prose-block__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--step-1);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--orbit-faint);
    margin-bottom: 16px;
    color: var(--text);
  }

  .prose-block__index {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--gold);
  }

  .prose-block p {
    color: var(--text-2);
    line-height: 1.95;
    font-size: var(--step-0);
  }

  .prose-block__aside {
    margin-top: 14px;
    font-size: 0.78rem;
    color: var(--text-3);
    line-height: 1.7;
  }

  /* ---------------- sources ---------------- */
  .sources {
    list-style: none;
  }

  .source {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--orbit-faint);
  }

  .source:last-child {
    border-bottom: 0;
  }

  .source__type {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    padding: 2px 0;
    text-align: center;
    height: fit-content;
  }

  .source__type--pending {
    color: var(--quantum);
    border-color: color-mix(in srgb, var(--quantum) 45%, transparent);
  }

  .source__type--link {
    color: var(--glow);
    border-color: color-mix(in srgb, var(--glow) 42%, transparent);
  }

  .source__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .source__title {
    font-size: var(--step-0);
    color: var(--text);
  }

  .source__ext {
    font-size: 0.8em;
    margin-left: 3px;
  }

  .source__detail {
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .source__note {
    font-size: 0.78rem;
    color: var(--text-2);
    line-height: 1.75;
  }

  /* ---------------- credits ---------------- */
  .credits {
    margin: 0;
  }

  .credits__row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--orbit-faint);
  }

  .credits__row:last-child {
    border-bottom: 0;
  }

  .credits dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    color: var(--text-3);
    padding-top: 3px;
  }

  .credits dd {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-2);
    line-height: 1.75;
  }

  /* ---------------- switcher ---------------- */
  .switcher {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--orbit-faint);
  }

  .switcher__label {
    margin-bottom: 12px;
  }

  .switcher__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .switcher__item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 12px 14px;
    border: 1px solid var(--orbit-faint);
    border-radius: var(--radius-sm);
    background: var(--panel);
    transition: border-color 0.16s var(--ease);
  }

  .switcher__item:hover {
    border-color: var(--orbit);
  }

  .switcher__item--next {
    justify-content: flex-end;
    text-align: right;
  }

  .switcher__band {
    display: inline-flex;
    flex: none;
    width: 62px;
    height: 34px;
    overflow: hidden;
    border-radius: 2px;
  }

  .switcher__band i {
    flex: 1 1 0;
    min-width: 0;
    background: var(--tone);
    box-shadow: inset 0 0 0 0.5px rgb(128 128 128 / 0.2);
  }

  .switcher__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .switcher__dir {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .switcher__name {
    font-family: var(--font-display);
    font-size: 0.94rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .switcher__all {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-2);
    border-bottom: 1px solid var(--orbit);
    padding-bottom: 3px;
  }

  .switcher__all:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  /* ---------------- console ---------------- */
  .detail__rail {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .detail__console {
    border: 1px solid var(--orbit-faint);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 0 clamp(14px, 1.8vw, 24px) 22px;
  }

  @media (min-width: 1081px) {
    .detail__console {
      position: sticky;
      top: 82px;
      height: calc(100vh - 106px);
      display: flex;
      flex-direction: column;
      padding-bottom: 0;
      overflow: hidden;
    }

    .detail__console-body {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: 22px;
      scrollbar-width: thin;
      scrollbar-color: var(--orbit) transparent;
    }

    .detail__console-body::-webkit-scrollbar {
      width: 8px;
    }

    .detail__console-body::-webkit-scrollbar-thumb {
      background: var(--orbit-dim);
      border-radius: 4px;
    }

    .detail__console-body::-webkit-scrollbar-track {
      background: transparent;
    }
  }

  @media (max-width: 1080px) {
    .detail__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .detail__spine {
      display: none;
    }

    .detail__story {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .switcher__row {
      grid-template-columns: 1fr;
    }
  }
</style>
