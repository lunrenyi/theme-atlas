---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="页面不存在" description="这个页面不在档案里。">
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow eyebrow--gold">404 · 信号丢失</p>
      <h1 class="notfound__title">这个页面不在档案里</h1>
      <p class="lede">
        也许它被重新归档了，或者链接里少了一段。回到档案首页，按名字或颜色找一找。
      </p>
      <svg class="notfound__chart" viewBox="0 0 320 140" aria-hidden="true" fill="none">
        <g stroke="#344363" stroke-width="1">
          <circle cx="160" cy="70" r="58" stroke-dasharray="3 6" opacity="0.5"></circle>
          <ellipse cx="160" cy="70" rx="58" ry="20" transform="rotate(-18 160 70)" opacity="0.45"></ellipse>
          <path d="M160 6v128M96 70h128" opacity="0.2" stroke-dasharray="2 6"></path>
        </g>
        <circle cx="160" cy="70" r="5" fill="#DCC38B" opacity="0.85"></circle>
        <circle cx="214" cy="52" r="3" fill="#9885FF" opacity="0.8"></circle>
        <circle cx="106" cy="92" r="2.4" fill="#76D8DF" opacity="0.7"></circle>
        <path d="M160 70L214 52" stroke="#9885FF" stroke-width="1" opacity="0.5"></path>
      </svg>
      <div class="notfound__actions">
        <a class="btn btn--solid" href={withBase('/')}>回到首页</a>
        <a class="btn btn--ghost" href={withBase('/#themes')}>浏览全部主题</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(72px, 12vw, 180px);
    max-width: 640px;
  }

  .notfound__title {
    font-size: var(--step-4);
    margin: 16px 0 20px;
  }

  .notfound__chart {
    width: min(320px, 100%);
    margin: 28px 0 6px;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
</style>

