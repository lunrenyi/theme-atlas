---
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionMotif from '../components/CollectionMotif.astro';
import ThemeCard from '../components/ThemeCard.astro';
import ThemeLibrary from '../components/ThemeLibrary.astro';
import { collections } from '../data/collections';
import { themes } from '../data/themes';
---

<BaseLayout
  title="主题系列"
  description="中国神话、中国瓷器与崩坏：星穹铁道同人主题——三个配色来源，三种视觉语气。"
>
  <section class="page-head">
    <div class="wrap wrap--wide">
      <p class="eyebrow eyebrow--accent">Collections</p>
      <h1 class="page-head__title">主题系列</h1>
      <p class="lede">
        每个系列有自己的取材范围与配色纪律。中国神话靠矿物颜料，瓷器靠釉色的明度关系，
        同人系列则把虚构世界的光重新推导一遍。
      </p>
    </div>
  </section>

  {
    collections.map((collection, index) => {
      const list = themes.filter((t) => t.collection === collection.id);
      return (
        <section class="section collection" id={collection.id}>
          <div class="wrap wrap--wide">
            <div class="collection__head">
              <div class="collection__intro">
                <span class="collection__index mono">COLLECTION {String(index + 1).padStart(2, '0')}</span>
                <h2 class="collection__title">{collection.title}</h2>
                <p class="collection__en mono">{collection.titleEn}</p>
                <p class="collection__tagline">{collection.tagline}</p>
                <p class="collection__desc">{collection.description}</p>
                <p class="collection__count mono">{list.length} 套主题</p>
              </div>
              <CollectionMotif
                variant={collection.motif}
                accent={collection.accent}
                accentAlt={collection.accentAlt}
                class="collection__motif"
              />
            </div>

            <div class="collection__grid">
              {list.map((theme) => (
                <ThemeCard theme={theme} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section" id="all">
    <div class="wrap wrap--wide">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">全部</p>
          <h2 class="section-head__title">跨系列检索</h2>
        </div>
        <p class="section-head__meta">{themes.length} Themes</p>
      </div>
      <ThemeLibrary themes={themes} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(48px, 7vw, 100px) clamp(16px, 2vw, 28px);
    border-bottom: 1px solid var(--rule);
  }

  .page-head__title {
    font-size: var(--step-4);
    margin: 14px 0 18px;
  }

  .collection {
    border-bottom: 1px solid var(--rule);
  }

  .collection__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .collection__index {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }

  .collection__title {
    font-size: var(--step-3);
    margin-top: 10px;
  }

  .collection__en {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 6px;
  }

  .collection__tagline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-top: 16px;
    line-height: 1.45;
  }

  .collection__desc {
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.85;
    margin-top: 12px;
    max-width: 52ch;
  }

  .collection__count {
    margin-top: 16px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }

  :global(.collection__motif) {
    width: 100%;
    height: auto;
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(288px, 1fr));
    gap: 22px;
  }

  @media (max-width: 820px) {
    .collection__head {
      grid-template-columns: 1fr;
    }
  }
</style>

