---
import ThemeDetail from '../../views/ThemeDetail.astro';
import { getThemes } from '../../lib/content';

export function getStaticPaths() {
  return getThemes('zh').map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}
---

<ThemeDetail theme={Astro.props.theme} lang="zh" />
