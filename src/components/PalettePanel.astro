---
/**
 * The role table of a theme: every colour, its name, its hex value, the
 * semantic slot it fills and where it comes from. The pinned readout with the
 * key colour and the luminance chart lives in PaletteHud.
 */
import type { Theme } from '../data/types';
import { adapters } from '../adapters';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

const roleLabels: Record<string, string> = {
  bg: '背景',
  surface: '面板',
  text: '正文',
  muted: '次要文字',
  border: '分割线',
  accent: '强调',
  onAccent: '强调上文字',
};

const exports: Record<string, { text: string; mime: string; extension: string }> = {};
for (const adapter of adapters) {
  exports[adapter.id] = {
    text: adapter.render(theme),
    mime: adapter.mime,
    extension: adapter.extension,
  };
}

const payload = JSON.stringify(exports).replace(/</g, '\u003c');
---

<section class="palette" aria-labelledby="palette-heading">
  <ul class="palette__rows">
    {
      theme.palette.map((color) => (
        <li
          class:list={['swatch', { 'swatch--accent': color.role === 'accent' }]}
          style={'--swatch:' + color.hex}
        >
          <span class="swatch__band" aria-hidden="true"></span>
          <button
            type="button"
            class="swatch__copy"
            data-copy-color={color.hex}
            aria-label={'复制颜色 ' + color.name + ' ' + color.hex}
          >
            <span class="swatch__name">{color.name}</span>
            <span class="swatch__hex mono">{color.hex}</span>
          </button>
          <span class="swatch__role mono">{roleLabels[color.role] ?? color.role}</span>
          {color.note && <p class="swatch__note">{color.note}</p>}
        </li>
      ))
    }
  </ul>

  <div class="palette__actions">
    <button type="button" class="btn btn--sm btn--solid" data-copy-all>复制整套配色</button>
    {
      adapters.map((adapter) => (
        <button type="button" class="btn btn--sm btn--ghost" data-export={adapter.id}>
          导出 {adapter.label}
        </button>
      ))
    }
  </div>

  <p class="palette__status" role="status" aria-live="polite" data-palette-status></p>

  <script type="application/json" data-export-payload set:html={payload} />
</section>

<style>
  .palette {
    display: block;
    padding-top: 6px;
  }

  .palette__rows {
    list-style: none;
  }

  .swatch {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr) auto;
    column-gap: 14px;
    row-gap: 3px;
    align-items: baseline;
    padding: 12px 0 13px;
    border-bottom: 1px solid var(--orbit-faint);
  }

  /* the colour itself, as a thin band on the left of the row */
  .swatch__band {
    grid-row: 1 / span 2;
    align-self: stretch;
    background: var(--swatch);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.14);
  }

  .swatch__copy {
    grid-column: 2;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .swatch__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--text);
  }

  .swatch__hex {
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: var(--text-3);
    transition: color 0.16s var(--ease);
  }

  .swatch__copy:hover .swatch__hex {
    color: var(--glow);
  }

  .swatch__copy:focus-visible {
    outline: 1px solid var(--quantum);
    outline-offset: 4px;
  }

  .swatch__role {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    white-space: nowrap;
  }

  .swatch--accent .swatch__name {
    color: var(--gold);
  }

  .swatch--accent .swatch__role {
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .swatch__note {
    grid-column: 2 / span 2;
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text-3);
  }

  .palette__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .palette__status {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--glow);
    min-height: 1.2em;
  }

  .palette__status:empty {
    min-height: 0;
  }
</style>

<script>
  import { copyText, downloadText } from '../lib/clipboard';

  const payloadEl = document.querySelector<HTMLScriptElement>('[data-export-payload]');
  // two readouts exist: one pinned in the header, one next to the buttons
  const statusEls = Array.from(document.querySelectorAll<HTMLElement>('[data-palette-status]'));

  const exports: Record<string, { text: string; mime: string; extension: string }> = payloadEl
    ? JSON.parse(payloadEl.textContent ?? '{}')
    : {};

  const slug = document.querySelector<HTMLElement>('[data-theme-slug]')?.dataset.themeSlug ?? 'theme';

  function say(message: string) {
    statusEls.forEach((el) => {
      el.textContent = message;
    });
    window.setTimeout(() => {
      statusEls.forEach((el) => {
        if (el.textContent === message) el.textContent = '';
      });
    }, 2600);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-color]').forEach((button) => {
    button.addEventListener('click', async () => {
      const hex = button.dataset.copyColor ?? '';
      const ok = await copyText(hex);
      say(ok ? '已复制 ' + hex : '复制失败，请手动选择 ' + hex);
    });
  });

  // the whole set, read from the role rows (the chart bars are not rows)
  document.querySelector<HTMLButtonElement>('[data-copy-all]')?.addEventListener('click', async () => {
    const lines = Array.from(document.querySelectorAll<HTMLElement>('.swatch')).map((row) => {
      const hex = row.querySelector('.swatch__hex')?.textContent?.trim() ?? '';
      const name = row.querySelector('.swatch__name')?.textContent?.trim() ?? '';
      const role = row.querySelector('.swatch__role')?.textContent?.trim() ?? '';
      return name + '  ' + hex + '  ' + role;
    });
    const ok = await copyText(lines.join('\n'));
    say(ok ? '已复制整套配色（' + lines.length + ' 色）' : '复制失败，请手动选择');
  });

  document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.export ?? '';
      const entry = exports[id];
      if (!entry) return;
      downloadText(slug + '.' + entry.extension, entry.text, entry.mime);
      say('已导出 ' + slug + '.' + entry.extension);
    });
  });
</script>
