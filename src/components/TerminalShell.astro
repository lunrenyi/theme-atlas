---
import type { Theme } from '../data/types';
import { luminance, paletteMap } from '../lib/color';

interface Props {
  theme: Theme;
  kind: 'prompt' | 'vim' | 'codex';
  title: string;
  subtitle: string;
  ariaLabel: string;
  class?: string;
}

const { theme, kind, title, subtitle, ariaLabel, class: className = '' } = Astro.props;
const map = paletteMap(theme);
const isDarkGround = luminance(map.bg?.hex ?? '#000000') < 0.32;
const vars = [
  '--terminal-frame:' + (isDarkGround ? '#FFFFFF' : '#000000'),
  '--terminal-chrome:' + (isDarkGround ? '#111111' : '#F2F2F2'),
  '--terminal-chrome-text:' + (isDarkGround ? '#F5F5F5' : '#111111'),
].join(';');
---

<figure
  class:list={['terminal-shell', className]}
  data-terminal-window
  data-terminal-kind={kind}
  aria-label={ariaLabel}
  style={vars}
>
  <div class="terminal-shell__bar">
    <span class="terminal-shell__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="terminal-shell__title mono">{title}</span>
    <span class="terminal-shell__subtitle mono">{subtitle}</span>
  </div>
  <div class="terminal-shell__screen">
    <slot />
  </div>
</figure>

<style>
  .terminal-shell {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--terminal-frame);
    border-radius: 4px;
    background: var(--t-bg);
    color: var(--t-text);
  }

  .terminal-shell__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 35px;
    padding: 7px 11px;
    border-bottom: 1px solid var(--terminal-frame);
    background: var(--terminal-chrome);
    color: var(--terminal-chrome-text);
  }

  .terminal-shell__dots {
    display: inline-flex;
    flex: none;
    gap: 6px;
  }

  .terminal-shell__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.18);
  }

  .terminal-shell__dots i:nth-child(1) {
    background: #ff5f57;
  }

  .terminal-shell__dots i:nth-child(2) {
    background: #febc2e;
  }

  .terminal-shell__dots i:nth-child(3) {
    background: #28c840;
  }

  .terminal-shell__title {
    color: var(--terminal-chrome-text);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }

  .terminal-shell__subtitle {
    margin-left: auto;
    color: color-mix(in srgb, var(--terminal-chrome-text) 58%, transparent);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
  }

  .terminal-shell__screen {
    min-width: 0;
    background: var(--t-bg);
    color: var(--t-text);
  }

  @media (max-width: 520px) {
    .terminal-shell__subtitle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-shell * {
      transition: none;
    }
  }
</style>
