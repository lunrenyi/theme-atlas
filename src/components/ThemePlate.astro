            <path d="M127 143c13-5 27-5 40 0M131 150c11-3 23-2 34 2" />
          </g>
          <path d="M139 171h42" stroke={line} stroke-width="1.1" opacity="0.55" />
        </g>
      )
    }

    {
      variant === 'famille-rose' && (
        <g>
          <ellipse cx="160" cy="180" rx="73" ry="9" fill={soft} opacity="0.15" />
          <path d="M67 47c30-15 56 10 76 3M259 52c-27-13-51 7-70 0" stroke={soft} stroke-width="0.8" opacity="0.35" />

          {/* an original tall porcelain vase, used only as a decorative ground */}
          <path
            d="M148 27h24v17c0 14 8 22 22 31 31 18 48 38 49 60 1 26-32 39-83 39s-84-13-83-39c1-22 18-42 49-60 14-9 22-17 22-31z"
