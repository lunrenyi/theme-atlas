    {
      variant === 'longquan-meizi' && (
        <g>
          <path d="M18 185c38-20 83-21 142-21s104 1 142 21" stroke={line} stroke-width="1" opacity="0.48" />
          <path d="M48 51c39-17 77 10 112 0s77-17 112 0M70 157c26-11 61 10 90 0s64-11 90 0" stroke={soft} stroke-width="0.9" opacity="0.42" />

          {/* handles and rim */}
          <path d="M112 63c-20-5-31 4-30 18 1 12 11 19 25 17M208 63c20-5 31 4 30 18-1 12-11 19-25 17" fill="none" stroke={line} stroke-width="1.4" />
