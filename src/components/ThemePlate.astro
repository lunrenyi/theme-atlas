          </g>
          <g fill={accent} opacity="0.9">
            <circle cx="138" cy="99" r="3.2" />
            <circle cx="168" cy="92" r="2.3" />
            <circle cx="198" cy="121" r="2.7" />
          </g>
          <g fill={artYellow}>
            <circle cx="139" cy="97" r="1" />
            <circle cx="169" cy="90" r="0.8" />
            <circle cx="199" cy="119" r="0.9" />
