          <path d="M118 75c2 21 5 39 12 55M202 75c-2 21-5 39-12 55" stroke={bright} stroke-width="2.6" opacity="0.18" />

          {/* exposed pale ridges and three legs */}
          <g stroke={bright} stroke-width="1.2" opacity="0.78">
            <path d="M137 70v80M160 69v87M183 70v80" />
            <path d="M107 111h106" stroke-width="0.9" opacity="0.58" />
          </g>
          <path d="M130 132l-7 51M160 136v48M190 132l7 51" stroke={line} stroke-width="2.4" stroke-linecap="round" />
