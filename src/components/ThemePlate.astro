          {/* fine branch, layered peonies, leaves and a small bird */}
          <g fill="none" stroke={artGreen} stroke-width="1.1" stroke-linecap="round" opacity="0.92">
            <path d="M143 158c5-21 0-38 13-51 10-10 23-14 35-24M158 109c-17-12-29-13-40-4M179 98c12 5 22 15 27 28" />
            <path d="M131 101c-8-8-17-10-25-6M194 115c10-7 20-8 29-3M158 126c9 7 20 11 31 11" />
          </g>
          <g fill={artGreen} opacity="0.16">
            <path d="M119 92c-14-3-22-12-24-23 13-2 23 4 29 16z" />
            <path d="M120 113c-12 7-24 5-31-3 9-9 20-10 31-4z" />
            <path d="M196 113c14-6 27-3 33 6-11 8-23 6-33 0z" />
            <path d="M178 145c-3 12-12 20-24 22 0-13 7-22 20-27z" />
          </g>
          <g stroke={artGreen} stroke-width="0.7" fill="none" opacity="0.7">
            <path d="M108 79c7-4 13-5 19-2M102 109c8-3 15-2 21 2M209 116c8-3 14-2 19 2M168 159c5-3 10-4 15-3" />
          </g>
          <g fill={accent} fill-opacity="0.17" stroke={accent} stroke-width="0.9">
            <path d="M127 112c-17-11-23-27-12-39 16 3 25 16 24 32z" />
            <path d="M146 112c-7-19 0-34 14-40 12 12 12 29-1 42z" />
            <path d="M135 126c-18-1-29-12-29-26 17-4 30 6 34 22z" />
            <path d="M116 118c-13 3-23-3-25-14 12-7 23-2 29 10z" />
            <path d="M190 131c-12-14-9-29 4-37 14 7 18 22 9 36z" />
            <path d="M201 141c-10 0-17-7-17-17 10-3 18 3 21 13z" />
          </g>
          <g fill="none" stroke={accent} stroke-width="0.7" opacity="0.52">
