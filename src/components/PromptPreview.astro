---
import type { PaletteRole, PromptModuleId, Theme } from '../data/types';
import { luminance, paletteMap } from '../lib/color';
import { t, type Locale, type UiKey } from '../i18n';
import PromptMotif from './PromptMotif.astro';

interface Props {
  theme: Theme;
  lang: Locale;
}

const { theme, lang } = Astro.props;
const design = theme.promptDesign;
const map = paletteMap(theme);

const roleKeys: Record<PaletteRole, UiKey> = {
  bg: 'palette.role.bg',
  surface: 'palette.role.surface',
  text: 'palette.role.text',
  muted: 'palette.role.muted',
  border: 'palette.role.border',
  accent: 'palette.role.accent',
  onAccent: 'palette.role.onAccent',
  flare: 'palette.role.flare',
};

const baseRoles: PaletteRole[] = ['bg', 'surface', 'text', 'muted', 'border', 'accent', 'onAccent'];
const legendRoles = map.flare ? [...baseRoles, 'flare' as const] : baseRoles;
const isDarkGround = luminance(map.bg?.hex ?? '#000000') < 0.32;
const frameVars = [
  '--prompt-frame:' + (isDarkGround ? '#FFFFFF' : '#000000'),
  '--prompt-chrome:' + (isDarkGround ? '#111111' : '#F2F2F2'),
  '--prompt-chrome-text:' + (isDarkGround ? '#F5F5F5' : '#111111'),
].join(';');

const contextModules = design.moduleOrder.filter(
  (module): module is Exclude<PromptModuleId, 'command' | 'status'> =>
    module !== 'command' && module !== 'status',
);
const entryModules = design.moduleOrder.filter(
  (module): module is 'command' | 'status' => module === 'command' || module === 'status',
);

const sceneId = 'prompt-scene-' + theme.slug;
const designNote = lang === 'zh' ? design.designNote : design.designNoteEn;

const emphasisFor = (role: PaletteRole) => {
  if (design.roleEmphasis.primary.includes(role)) return 'primary';
  if (design.roleEmphasis.secondary.includes(role)) return 'secondary';
  if (design.roleEmphasis.restrained.includes(role)) return 'restrained';
  return 'secondary';
};

const emphasisLabel = (level: string) => {
  if (level === 'primary') return t(lang, 'preview.promptPrimary');
  if (level === 'secondary') return t(lang, 'preview.promptSecondary');
  return t(lang, 'preview.promptRestrained');
};

const legend = legendRoles.map((role) => {
  const color = map[role];
  const roleLabel = t(lang, roleKeys[role]);
  return {
    role,
    color,
    roleLabel,
    emphasis: emphasisFor(role),
    accessibleLabel: t(lang, 'preview.promptRoleButton', {
      role: roleLabel,
      name: color?.name ?? '',
      hex: color?.hex ?? '',
    }),
  };
});
---

<div
  class="prompt-preview"
  data-prompt-preview
  data-theme={theme.slug}
  data-visual-style={design.visualStyle}
  data-prompt-layout={design.layout}
  data-line-mode={design.defaultLineMode}
  data-role-primary={design.roleEmphasis.primary.join(' ')}
  data-git="on"
  style={frameVars}
>
  <div class="prompt-preview__controls">
    <div class="prompt-preview__layout" role="group" aria-label={t(lang, 'preview.terminalLayoutLabel')}>
      <span class="prompt-preview__control-label mono">{t(lang, 'preview.terminalLayoutLabel')}</span>
      <button
        type="button"
        class:list={['prompt-preview__button', { 'is-active': design.defaultLineMode === 'single' }]}
        data-prompt-line-mode="single"
        aria-controls={sceneId}
        aria-pressed={design.defaultLineMode === 'single' ? 'true' : 'false'}
        title={t(lang, 'preview.terminalSingleTitle')}
      >
        {t(lang, 'preview.terminalSingle')}
      </button>
      <button
        type="button"
        class:list={['prompt-preview__button', { 'is-active': design.defaultLineMode === 'double' }]}
        data-prompt-line-mode="double"
        aria-controls={sceneId}
        aria-pressed={design.defaultLineMode === 'double' ? 'true' : 'false'}
        title={t(lang, 'preview.terminalDoubleTitle')}
      >
        {t(lang, 'preview.terminalDouble')}
      </button>
    </div>

    <label class="prompt-preview__git-toggle">
      <input type="checkbox" data-prompt-git checked />
      <span title={t(lang, 'preview.terminalShowGitTitle')}>
        {t(lang, 'preview.terminalShowGit')}
      </span>
    </label>
  </div>

  <figure
    class="prompt-window"
    data-prompt-layout={design.layout}
    aria-label={`Static zsh prompt preview for ${theme.slug}`}
  >
    <div class="prompt-window__bar">
      <span class="prompt-window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="prompt-window__title mono">zsh - ~/theme-atlas</span>
      <span class="prompt-window__subtitle mono">starship / oh-my-zsh inspired</span>
    </div>

    <div id={sceneId} class="prompt-window__screen" data-prompt-role="bg">
      <PromptMotif
        variant={design.motif}
        density={design.motifDensity}
        hasFlare={Boolean(map.flare)}
      />

      <div class="prompt-scene">
        <div class="prompt-prompt">
          <div class="prompt-context-modules">
            {
              contextModules.map((moduleId, moduleIndex) => (
                <>
                  {moduleIndex > 0 && (
                    <span class="prompt-separator" data-prompt-role="muted" aria-hidden="true">
                      {design.glyphSet.separator}
                    </span>
                  )}
                  <span
                    class:list={['prompt-module', 'prompt-module--' + moduleId]}
                    data-prompt-module={moduleId}
                  >
                    {moduleId === 'user' && (
                      <span class="prompt-user-host">
                        <span data-prompt-role="text">dev</span>
                        <span class="prompt-muted" data-prompt-role="muted">@</span>
                        <span data-prompt-role="text">atlas</span>
                      </span>
                    )}
                    {moduleId === 'directory' && (
                      <span class="prompt-directory" data-prompt-role="text">~/theme-atlas</span>
                    )}
                    {moduleId === 'git' && (
                      <span class="prompt-git">
                        <span class="prompt-branch" data-prompt-role="accent onAccent">main</span>
                        <span class="prompt-git-state" data-prompt-role="text">1 modified</span>
                        {map.flare && (
                          <span
                            class="prompt-dirty"
                            data-prompt-role="flare"
                            role="img"
                            aria-label="dirty working tree"
                          >*</span>
                        )}
                      </span>
                    )}
                    {moduleId === 'runtime' && (
                      <span class="prompt-runtime">
                        <span data-prompt-role="text">node</span>
                        <span class="prompt-muted" data-prompt-role="muted">v22.11.0</span>
                      </span>
                    )}
                  </span>
                </>
              ))
            }
          </div>

          <div class="prompt-entry-modules">
            {
              entryModules.map((moduleId) => (
                <span
                  class:list={['prompt-module', 'prompt-module--' + moduleId]}
                  data-prompt-module={moduleId}
                >
                  {moduleId === 'command' && (
                    <span class="prompt-command">
                      <span class="prompt-symbol" data-prompt-role="accent" aria-hidden="true">
                        {design.glyphSet.prompt}
                      </span>
                      <span data-prompt-role="text">git status --short</span>
                    </span>
                  )}
                  {moduleId === 'status' && (
                    <span class="prompt-runtime-status">
                      <span data-prompt-role="text">exit 0</span>
                      <span class="prompt-muted" data-prompt-role="muted">42ms</span>
                    </span>
                  )}
                </span>
              ))
            }
          </div>
        </div>

        <div class="prompt-output" data-prompt-role="surface border">
          <span class="prompt-output__main">
            <span data-prompt-role="muted" aria-hidden="true">{design.glyphSet.connector}</span>
            <span data-prompt-role="text">M src/theme.ts</span>
          </span>
          <span class="prompt-output__meta">
            <span class="mono" data-prompt-role="text">{theme.slug}</span>
            <span data-prompt-role="muted">7 color roles mapped</span>
          </span>
        </div>
      </div>
    </div>
  </figure>

  <p class="prompt-preview__note">{t(lang, 'preview.terminalNote')}</p>

  <section class="prompt-roles" aria-labelledby={`prompt-roles-${theme.slug}`}>
    <div class="prompt-roles__head">
      <h3 id={`prompt-roles-${theme.slug}`} class="prompt-roles__title">
        {t(lang, 'preview.promptLegendTitle')}
      </h3>
      <p>{t(lang, 'preview.promptLegendHint')}</p>
    </div>

    <div class="prompt-roles__grid" role="group" aria-label={t(lang, 'preview.promptLegendTitle')}>
      {
        legend.map(({ role, color, roleLabel, emphasis, accessibleLabel }) => (
          <button
            type="button"
            class:list={['prompt-role', 'is-' + emphasis]}
            style={'--role-tone:' + (color?.hex ?? 'transparent')}
            data-prompt-role-button={role}
            aria-controls={sceneId}
            aria-pressed="false"
            title={accessibleLabel}
            aria-label={accessibleLabel}
          >
            <span class="prompt-role__swatch" aria-hidden="true"></span>
            <span class="prompt-role__copy">
              <span class="prompt-role__meta">
                <span class="prompt-role__label">{roleLabel}</span>
                <span class="prompt-role__emphasis">{emphasisLabel(emphasis)}</span>
              </span>
              <span class="prompt-role__name">{color?.name}</span>
              <span class="prompt-role__hex mono">{color?.hex}</span>
            </span>
          </button>
        ))
      }
    </div>
  </section>

  <p class="prompt-preview__design-note">
    <span class="mono">{t(lang, 'preview.promptDesignNoteLabel')}</span>
    {designNote}
  </p>
</div>

<script>
  const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-prompt-preview]'));

  previews.forEach((preview) => {
    const lineButtons = Array.from(
      preview.querySelectorAll<HTMLButtonElement>('[data-prompt-line-mode]'),
    );
    const gitToggle = preview.querySelector<HTMLInputElement>('[data-prompt-git]');
    const roleButtons = Array.from(
      preview.querySelectorAll<HTMLButtonElement>('[data-prompt-role-button]'),
    );
    const roleTargets = Array.from(
      preview.querySelectorAll<HTMLElement>('[data-prompt-role]'),
    );
    const roleVars: Record<string, string> = {
      bg: '--t-bg',
      surface: '--t-surface',
      text: '--t-text',
      muted: '--t-muted',
      border: '--t-border',
      accent: '--t-accent',
      onAccent: '--t-on-accent',
      flare: '--t-flare',
    };

    let pointerRole = '';
    let focusedRole = '';
    let pinnedRole = '';

    const applyRoleHighlight = () => {
      const activeRole = pointerRole || focusedRole || pinnedRole;
      if (activeRole) {
        preview.dataset.activeRole = activeRole;
        preview.style.setProperty('--prompt-highlight', `var(${roleVars[activeRole]})`);
      } else {
        delete preview.dataset.activeRole;
        preview.style.removeProperty('--prompt-highlight');
      }

      roleTargets.forEach((target) => {
        const roles = (target.dataset.promptRole ?? '').split(/\s+/).filter(Boolean);
        target.classList.toggle('is-role-highlighted', roles.includes(activeRole));
      });
    };

    const setLineMode = (mode: string) => {
      preview.dataset.lineMode = mode;
      lineButtons.forEach((button) => {
        const active = button.dataset.promptLineMode === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    lineButtons.forEach((button) => {
      button.addEventListener('click', () =>
        setLineMode(button.dataset.promptLineMode ?? 'single'),
      );
    });

    const setGit = () => {
      preview.dataset.git = gitToggle?.checked ? 'on' : 'off';
    };
    gitToggle?.addEventListener('change', setGit);
    setGit();

    roleButtons.forEach((button) => {
      const role = button.dataset.promptRoleButton ?? '';
      const setPointer = () => {
        pointerRole = role;
        applyRoleHighlight();
      };
      const clearPointer = () => {
        if (pointerRole === role) pointerRole = '';
        applyRoleHighlight();
      };
      const setFocus = () => {
        focusedRole = role;
        applyRoleHighlight();
      };
      const clearFocus = () => {
        if (focusedRole === role) focusedRole = '';
        applyRoleHighlight();
      };

      button.addEventListener('pointerenter', setPointer);
      button.addEventListener('pointerleave', clearPointer);
      button.addEventListener('focus', setFocus);
      button.addEventListener('blur', clearFocus);
      button.addEventListener('click', () => {
        pinnedRole = pinnedRole === role ? '' : role;
        roleButtons.forEach((candidate) => {
          candidate.setAttribute(
            'aria-pressed',
            String(candidate.dataset.promptRoleButton === pinnedRole),
          );
          candidate.classList.toggle(
            'is-pinned',
            candidate.dataset.promptRoleButton === pinnedRole,
          );
        });
        applyRoleHighlight();
      });
    });
  });
</script>

<style>
  .prompt-preview {
    --prompt-highlight: var(--quantum);
    min-width: 0;
  }

  .prompt-preview__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-bottom: 12px;
  }

  .prompt-preview__layout {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .prompt-preview__control-label {
    margin-right: 4px;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .prompt-preview__button {
    min-height: 30px;
    padding: 4px 10px;
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .prompt-preview__button:hover {
    border-color: var(--orbit);
    color: var(--text);
  }

  .prompt-preview__button.is-active {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, transparent);
    color: var(--gold);
  }

  .prompt-preview__git-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .prompt-preview__git-toggle input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--gold);
  }

  .prompt-window {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--prompt-frame);
    border-radius: 4px;
    background: var(--t-bg);
    color: var(--t-text);
  }

  .prompt-window__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 35px;
    padding: 7px 11px;
    border-bottom: 1px solid var(--prompt-frame);
    background: var(--prompt-chrome);
    color: var(--prompt-chrome-text);
  }

  .prompt-window__dots {
    display: inline-flex;
    flex: none;
    gap: 6px;
  }

  .prompt-window__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.18);
  }

  .prompt-window__dots i:nth-child(1) {
    background: #ff5f57;
  }

  .prompt-window__dots i:nth-child(2) {
    background: #febc2e;
  }

  .prompt-window__dots i:nth-child(3) {
    background: #28c840;
  }

  .prompt-window__title {
    color: var(--prompt-chrome-text);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }

  .prompt-window__subtitle {
    margin-left: auto;
    color: color-mix(in srgb, var(--prompt-chrome-text) 58%, transparent);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
  }

  .prompt-window__screen {
    position: relative;
    min-width: 0;
    padding: clamp(18px, 3.4vw, 30px);
    background: var(--t-bg);
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .prompt-scene {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    color: var(--t-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: clamp(0.76rem, 2.2vw, 0.88rem);
    line-height: 1.65;
  }

  .prompt-prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0;
    min-width: 0;
  }

  .prompt-context-modules,
  .prompt-entry-modules {
    display: contents;
  }

  .prompt-module {
    min-width: 0;
  }

  .prompt-module--user,
  .prompt-module--directory,
  .prompt-module--git,
  .prompt-module--runtime,
  .prompt-module--command,
  .prompt-module--status {
    overflow-wrap: anywhere;
  }

  .prompt-directory,
  .prompt-git-state,
  .prompt-runtime,
  .prompt-command,
  .prompt-runtime-status {
    color: var(--t-text);
  }

  .prompt-muted,
  .prompt-separator {
    color: var(--t-muted);
  }

  .prompt-user-host {
    display: inline-flex;
    align-items: baseline;
  }

  .prompt-branch {
    display: inline-block;
    padding: 1px 5px;
    background: var(--t-accent);
    color: var(--t-on-accent);
    font-weight: 700;
  }

  .prompt-git,
  .prompt-runtime,
  .prompt-command,
  .prompt-runtime-status {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
  }

  .prompt-dirty {
    color: var(--t-flare);
  }

  .prompt-symbol {
    color: var(--t-accent);
    font-weight: 700;
  }

  .prompt-output {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem 1rem;
    min-width: 0;
    padding: 8px 9px;
    border-top: 1px solid var(--t-border);
    background: var(--t-surface);
    color: var(--t-text);
    font-size: 0.9em;
  }

  .prompt-output__main,
  .prompt-output__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
  }

  .prompt-output__meta {
    color: var(--t-muted);
  }

  .prompt-preview[data-git='off'] .prompt-branch,
  .prompt-preview[data-git='off'] .prompt-git-state,
  .prompt-preview[data-git='off'] .prompt-dirty {
    display: none;
  }

  .prompt-preview[data-line-mode='double'] .prompt-prompt {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .prompt-preview[data-line-mode='double'] .prompt-context-modules,
  .prompt-preview[data-line-mode='double'] .prompt-entry-modules {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.55rem;
  }

  .prompt-preview[data-prompt-layout='minimal'] .prompt-module {
    white-space: nowrap;
  }

  .prompt-preview[data-prompt-layout='segmented'] .prompt-module {
    position: relative;
    padding: 3px 13px 3px 8px;
    background: var(--t-surface);
    border: 1px solid var(--t-border);
  }

  .prompt-preview[data-prompt-layout='segmented'] .prompt-module::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -8px;
    width: 0;
    height: 0;
    transform: translateY(-50%);
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 7px solid var(--t-surface);
    filter: drop-shadow(1px 0 0 var(--t-border));
  }

  .prompt-preview[data-prompt-layout='segmented'] .prompt-separator {
    display: none;
  }

  .prompt-preview[data-prompt-layout='two-line'] .prompt-entry-modules {
    padding-top: 7px;
    border-top: 1px solid var(--t-border);
  }

  .prompt-preview[data-line-mode='single'][data-prompt-layout='two-line'] .prompt-entry-modules {
    display: contents;
  }

  .prompt-preview__note {
    margin-top: 9px;
    color: var(--text-3);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .prompt-preview [data-prompt-role].is-role-highlighted {
    outline: 2px solid var(--prompt-highlight);
    outline-offset: 3px;
  }

  .prompt-roles {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--orbit-faint);
  }

  .prompt-roles__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 14px;
    margin-bottom: 10px;
  }

  .prompt-roles__title {
    font-size: 0.76rem;
    color: var(--text-2);
  }

  .prompt-roles__head p {
    color: var(--text-3);
    font-size: 0.64rem;
  }

  .prompt-roles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .prompt-role {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    min-width: 0;
    padding: 7px;
    border: 1px solid var(--orbit-faint);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2);
    text-align: left;
    cursor: pointer;
  }

  .prompt-role:hover,
  .prompt-role:focus-visible,
  .prompt-role.is-pinned {
    border-color: var(--gold);
    background: var(--panel-2);
  }

  .prompt-role.is-primary {
    box-shadow: inset 2px 0 0 var(--gold);
  }

  .prompt-role__swatch {
    width: 12px;
    height: 12px;
    margin-top: 2px;
    background: var(--role-tone);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  .prompt-role__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .prompt-role__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .prompt-role__label {
    font-size: 0.62rem;
    color: var(--text-3);
  }

  .prompt-role__emphasis {
    font-size: 0.55rem;
    color: var(--text-3);
  }

  .prompt-role.is-primary .prompt-role__emphasis {
    color: var(--gold);
  }

  .prompt-role__name {
    overflow: hidden;
    color: var(--text);
    font-size: 0.69rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prompt-role__hex {
    color: var(--text-3);
    font-size: 0.61rem;
    letter-spacing: 0.03em;
  }

  .prompt-preview__design-note {
    margin-top: 12px;
    color: var(--text-3);
    font-size: 0.68rem;
    line-height: 1.7;
  }

  .prompt-preview__design-note > span {
    margin-right: 7px;
    color: var(--gold);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .prompt-preview__controls {
      align-items: flex-start;
      flex-direction: column;
    }

    .prompt-window__screen {
      padding: 16px 14px;
    }

    .prompt-window__subtitle {
      display: none;
    }

    .prompt-scene {
      gap: 12px;
