---
/**
 * The hero star map: one core body, three orbits, one node per collection.
 *
 * Everything is original geometry. The node positions are computed from the
 * orbit equations at build time, so every marker sits exactly on its ring,
 * and the star field is generated from a fixed seed, so the sky is identical
 * on every build and needs no runtime data.
 *
 * Motion is CSS only: a slow breathing core, two counter-rotating arcs and
 * light points travelling along the orbits. `prefers-reduced-motion` leaves a
 * complete, static chart behind.
 */
import type { Collection } from '../data/types';
import { getThemes } from '../lib/content';
import { localePath } from '../lib/url';
import { seriesNumber, t, type Locale } from '../i18n';

interface Props {
  collections: Collection[];
  lang: Locale;
}

const { collections, lang } = Astro.props;
const themes = getThemes(lang);

function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

interface Orbit {
  id: string;
  rx: number;
  ry: number;
  rot: number;
}

/** Three orbits carry a collection node; two more only add depth. */
const ORBITS: Orbit[] = [
  { id: 'porcelain', rx: 37, ry: 12.5, rot: -16 },
  { id: 'myth', rx: 23.5, ry: 20, rot: 44 },
  { id: 'rail', rx: 44, ry: 16.5, rot: 12 },
];

const BACKGROUND_ORBITS: Orbit[] = [
  { id: 'deep-1', rx: 46, ry: 27, rot: 74 },
  { id: 'deep-2', rx: 33, ry: 7.5, rot: -58 },
];

/** Where a marker sits on an ellipse, in map percentages. */
function pointOn(orbit: Orbit, angleDeg: number) {
  const a = (angleDeg * Math.PI) / 180;
  const r = (orbit.rot * Math.PI) / 180;
  const x = orbit.rx * Math.cos(a);
  const y = orbit.ry * Math.sin(a);
  return {
    x: 50 + x * Math.cos(r) - y * Math.sin(r),
    y: 50 + x * Math.sin(r) + y * Math.cos(r),
  };
}

/** The orbit path as a polyline, used by the travelling light points. */
function orbitPath(orbit: Orbit, steps = 60): string {
  const points: string[] = [];
  for (let i = 0; i <= steps; i++) {
    const p = pointOn(orbit, (i / steps) * 360);
    points.push(p.x.toFixed(2) + ',' + p.y.toFixed(2));
  }
  return 'M' + points.join('L');
}

/** Node placement — a calm triangle around the core. */
const NODE_PLAN: Record<
  string,
  { orbit: string; angle: number; place: 'left' | 'right' | 'below' }
> = {
  myth: { orbit: 'myth', angle: 150, place: 'left' },
  porcelain: { orbit: 'porcelain', angle: 115, place: 'below' },
  rail: { orbit: 'rail', angle: 298, place: 'right' },
};

const nodes = collections.map((collection, i) => {
  const plan = NODE_PLAN[collection.id] ?? { orbit: 'rail', angle: 0, place: 'right' as const };
  const orbit = ORBITS.find((o) => o.id === plan.orbit) ?? ORBITS[0];
  const point = pointOn(orbit, plan.angle);
  const theme = themes.find((t) => t.collection === collection.id);
  const swatches = theme ? theme.palette.slice(0, 4) : [];
  return {
    collection,
    plan,
    point,
    swatches,
    index: i,
    count: themes.filter((t) => t.collection === collection.id).length,
  };
});

/* ---- the sky ------------------------------------------------------ */

const rand = mulberry32(20261028);

const farStars = Array.from({ length: 120 }, () => ({
  x: rand() * 100,
  y: rand() * 100,
  r: 0.05 + rand() * 0.13,
  o: 0.12 + rand() * 0.3,
  tone: rand() > 0.86 ? '#DCC38B' : rand() > 0.78 ? '#76D8DF' : '#EAF0FF',
}));

const midStars = Array.from({ length: 42 }, () => ({
  x: rand() * 100,
  y: rand() * 100,
  r: 0.14 + rand() * 0.16,
  o: 0.28 + rand() * 0.34,
  tone: rand() > 0.8 ? '#9885FF' : '#EAF0FF',
}));

const nearStars = Array.from({ length: 11 }, () => ({
  x: 4 + rand() * 92,
  y: 4 + rand() * 92,
  r: 0.26 + rand() * 0.26,
  o: 0.45 + rand() * 0.4,
  tone: rand() > 0.7 ? '#DCC38B' : rand() > 0.45 ? '#76D8DF' : '#EAF0FF',
}));

/** Motes that drift in front of the core — the near plane of the chart. */
const foreDust = Array.from({ length: 16 }, () => ({
  x: rand() * 100,
  y: rand() * 100,
  r: 0.18 + rand() * 0.5,
  o: 0.12 + rand() * 0.3,
}));

/** Dial ticks around the outer ring. */
const dialTicks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const long = i % 6 === 0;
  const r1 = long ? 44.6 : 46;
  const r2 = 47;
  return {
    x1: 50 + r1 * Math.cos(a),
    y1: 50 + r1 * Math.sin(a),
    x2: 50 + r2 * Math.cos(a),
    y2: 50 + r2 * Math.sin(a),
    o: long ? 0.55 : 0.28,
  };
});

/** Light points running along the orbits. */
const travellers = [
  { orbit: ORBITS[2], dur: '26s', delay: '-4s', r: 0.42, tone: '#EAF0FF' },
  { orbit: ORBITS[0], dur: '34s', delay: '-17s', r: 0.34, tone: '#76D8DF' },
  { orbit: ORBITS[1], dur: '44s', delay: '-28s', r: 0.3, tone: '#DCC38B' },
];
---

<div class="starmap" data-starmap>
  <svg class="starmap__plot" viewBox="0 0 100 100" aria-hidden="true" fill="none">
    <defs>
      <radialGradient id="sm-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F4E4BC" stop-opacity="0.42"></stop>
        <stop offset="22%" stop-color="#DCC38B" stop-opacity="0.2"></stop>
        <stop offset="55%" stop-color="#9885FF" stop-opacity="0.09"></stop>
        <stop offset="100%" stop-color="#080D1C" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sm-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFF8E6" stop-opacity="0.9"></stop>
        <stop offset="34%" stop-color="#E8D09A" stop-opacity="0.42"></stop>
        <stop offset="100%" stop-color="#DCC38B" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sm-disc" cx="40%" cy="36%" r="66%">
        <stop offset="0%" stop-color="#FFFCF3"></stop>
        <stop offset="52%" stop-color="#EFDCAC"></stop>
        <stop offset="100%" stop-color="#C4A469"></stop>
      </radialGradient>
      <linearGradient id="sm-ray" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#DCC38B" stop-opacity="0"></stop>
        <stop offset="50%" stop-color="#DCC38B" stop-opacity="0.42"></stop>
        <stop offset="100%" stop-color="#DCC38B" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="sm-nebula-violet">
        <stop offset="0%" stop-color="#9885FF" stop-opacity="0.2"></stop>
        <stop offset="100%" stop-color="#9885FF" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sm-nebula-cyan">
        <stop offset="0%" stop-color="#76D8DF" stop-opacity="0.15"></stop>
        <stop offset="100%" stop-color="#76D8DF" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sm-nebula-gold">
        <stop offset="0%" stop-color="#DCC38B" stop-opacity="0.12"></stop>
        <stop offset="100%" stop-color="#DCC38B" stop-opacity="0"></stop>
      </radialGradient>
      <filter id="sm-blur" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="2.4"></feGaussianBlur>
      </filter>
    </defs>

    <!-- the deep plane -->
    <g class="sm-field">
      {
        farStars.map((s) => (
          <circle cx={s.x} cy={s.y} r={s.r} fill={s.tone} opacity={s.o} />
        ))
      }
      {
        midStars.map((s) => (
          <circle cx={s.x} cy={s.y} r={s.r} fill={s.tone} opacity={s.o} />
        ))
      }
      {
        nearStars.map((s) => (
          <g>
            <circle class="sm-star--glow" cx={s.x} cy={s.y} r={s.r * 3.4} fill={s.tone} opacity={s.o * 0.18} />
            <circle class="sm-star--near" cx={s.x} cy={s.y} r={s.r} fill={s.tone} opacity={s.o} />
          </g>
        ))
      }
    </g>

    <!-- faint nebula washes -->
    <g class="sm-nebula" filter="url(#sm-blur)">
      <ellipse cx="28" cy="26" rx="26" ry="16" fill="url(#sm-nebula-violet)"></ellipse>
      <ellipse cx="74" cy="70" rx="24" ry="15" fill="url(#sm-nebula-cyan)"></ellipse>
      <ellipse cx="58" cy="16" rx="18" ry="10" fill="url(#sm-nebula-gold)"></ellipse>
    </g>

    <!-- the instrument grid -->
    <g class="sm-grid" stroke="#344363" fill="none">
      <circle cx="50" cy="50" r="47" stroke-width="0.07" opacity="0.5"></circle>
      <circle cx="50" cy="50" r="30" stroke-width="0.06" opacity="0.28"></circle>
      <circle cx="50" cy="50" r="15" stroke-width="0.05" opacity="0.2"></circle>
      <path d="M50 3v94M3 50h94" stroke-width="0.05" opacity="0.22"></path>
      {
        dialTicks.map((tick) => (
          <line
            x1={tick.x1}
            y1={tick.y1}
            x2={tick.x2}
            y2={tick.y2}
            stroke-width="0.08"
            opacity={tick.o}
          />
        ))
      }
    </g>

    <!-- orbits -->
    <g class="sm-orbits">
      {
        nodes.map((node) => (
          <line
            class="sm-spoke"
            data-orbit={node.collection.id}
            x1="50"
            y1="50"
            x2={node.point.x}
            y2={node.point.y}
          />
        ))
      }
      {
        BACKGROUND_ORBITS.map((orbit) => (
          <ellipse
            class="sm-orbit sm-orbit--deep"
            data-orbit={orbit.id}
            cx="50"
            cy="50"
            rx={orbit.rx}
            ry={orbit.ry}
            transform={'rotate(' + orbit.rot + ' 50 50)'}
          />
        ))
      }
      {
        ORBITS.map((orbit) => (
          <ellipse
            class="sm-orbit sm-orbit--live"
            data-orbit={orbit.id}
            cx="50"
            cy="50"
            rx={orbit.rx}
            ry={orbit.ry}
            transform={'rotate(' + orbit.rot + ' 50 50)'}
          />
        ))
      }
    </g>

    <!-- light points running the orbits -->
    <g class="sm-travelers">
      {
        travellers.map((traveller) => (
          <circle
            class="sm-traveller"
            r={traveller.r}
            cx="0"
            cy="0"
            fill={traveller.tone}
            style={
              'offset-path: path(' + JSON.stringify(orbitPath(traveller.orbit)) + ');' +
              'animation-duration: ' + traveller.dur + ';' +
              'animation-delay: ' + traveller.delay + ';'
            }
          />
        ))
      }
    </g>

    <!-- the core body -->
    <g class="sm-core">
      <circle class="sm-core-halo" cx="50" cy="50" r="25" fill="url(#sm-halo)"></circle>
      <circle class="sm-core-glow" cx="50" cy="50" r="11" fill="url(#sm-glow)"></circle>

      <g class="sm-core-rays" stroke="url(#sm-ray)" stroke-width="0.14" stroke-linecap="round">
        <line x1="50" y1="34" x2="50" y2="66"></line>
        <line x1="34" y1="50" x2="66" y2="50"></line>
        <line x1="38.5" y1="38.5" x2="61.5" y2="61.5"></line>
        <line x1="61.5" y1="38.5" x2="38.5" y2="61.5"></line>
      </g>

      <circle class="sm-core-ring sm-core-ring--a" cx="50" cy="50" r="6.4"></circle>
      <circle class="sm-core-ring sm-core-ring--b" cx="50" cy="50" r="9.8"></circle>
      <circle class="sm-core-ring sm-core-ring--c" cx="50" cy="50" r="19.4"></circle>
      <circle class="sm-core-ring sm-core-ring--d" cx="50" cy="50" r="4.6"></circle>
      <g class="sm-core-arc sm-core-arc--a">
        <circle cx="50" cy="50" r="13.4" stroke-dasharray="7 78"></circle>
      </g>
      <g class="sm-core-arc sm-core-arc--b">
        <circle cx="50" cy="50" r="16.8" stroke-dasharray="4 96"></circle>
      </g>

      <circle class="sm-core-disc" cx="50" cy="50" r="3.3" fill="url(#sm-disc)"></circle>
    </g>

    <!-- the near plane: dust in front of the core -->
    <g class="sm-fore">
      <ellipse
        class="sm-fore-lane"
        cx="50"
        cy="52"
        rx="46"
        ry="2.2"
        transform="rotate(-16 50 52)"
      ></ellipse>
      {
        foreDust.map((mote) => (
          <circle cx={mote.x} cy={mote.y} r={mote.r} fill="#EAF0FF" opacity={mote.o} />
        ))
      }
    </g>
  </svg>

  <div class="starmap__nodes">
    {
      nodes.map((node) => (
        <a
          class:list={['starmap__node', 'starmap__node--' + node.plan.place]}
          data-collection={node.collection.id}
          style={
            '--x:' + node.point.x.toFixed(2) + '%;' +
            '--y:' + node.point.y.toFixed(2) + '%;' +
            '--tone:' + node.collection.accent
          }
          href={localePath('/collections#' + node.collection.id, lang)}
        >
          <span class="starmap__marker" aria-hidden="true">
            <i class="starmap__halo"></i>
            <i class="starmap__ring"></i>
            <i class="starmap__dot"></i>
          </span>

          <span class="starmap__label">
            <span class="starmap__code mono">
              {t(lang, 'series.code', { n: seriesNumber(lang, node.index) })}
            </span>
            <span class="starmap__name">{node.collection.short}</span>
            <span class="starmap__strip" aria-hidden="true">
              {node.swatches.map((c) => (
                <i style={'--swatch:' + c.hex} />
              ))}
            </span>
          </span>

          <span class="starmap__note">{node.collection.starNote}</span>

          <span class="sr-only">
            {' ' + t(lang, 'star.nodeLabel', { title: node.collection.title, count: node.count })}
          </span>
        </a>
      ))
    }
  </div>

  <p class="starmap__core-label mono" aria-hidden="true">
    <span>{t(lang, 'star.coreBrand')}</span>
    <span>{t(lang, 'star.coreLabel')}</span>
  </p>
</div>

<style>
  .starmap {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    aspect-ratio: 1;
    --px: 0;
    --py: 0;
  }

  .starmap__plot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* --- the planes ------------------------------------------------- */
  .sm-field,
  .sm-fore {
    transform: translate3d(calc(var(--px) * -4px), calc(var(--py) * -4px), 0);
    transition: transform 0.7s var(--ease);
  }

  .sm-fore {
    transform: translate3d(calc(var(--px) * 7px), calc(var(--py) * 7px), 0);
  }

  .sm-core {
    transform: translate3d(calc(var(--px) * 2px), calc(var(--py) * 2px), 0);
    transition: transform 0.9s var(--ease);
  }

  .sm-orbits,
  .sm-travelers {
    transform: translate3d(calc(var(--px) * -1.5px), calc(var(--py) * -1.5px), 0);
    transition: transform 0.8s var(--ease);
  }

  /* --- the core body ---------------------------------------------- */
  .sm-core-halo,
  .sm-core-glow,
  .sm-core-rays,
  .sm-core-arc {
    transform-box: view-box;
    transform-origin: 50px 50px;
  }

  .sm-core-ring {
    stroke: #dcc38b;
    fill: none;
  }

  .sm-core-ring--a {
    stroke-width: 0.13;
    opacity: 0.7;
  }

  .sm-core-ring--b {
    stroke-width: 0.09;
    stroke-dasharray: 0.6 1.9;
    opacity: 0.55;
  }

  .sm-core-ring--c {
    stroke-width: 0.07;
    stroke-dasharray: 0.25 2.6;
    opacity: 0.45;
  }

  .sm-core-ring--d {
    stroke: #fff6dc;
    stroke-width: 0.1;
    opacity: 0.65;
  }

  .sm-core-arc circle {
    fill: none;
    stroke-width: 0.22;
  }

  .sm-core-arc--a circle {
    stroke: #eaf0ff;
    opacity: 0.72;
  }

  .sm-core-arc--b circle {
    stroke: #76d8df;
    opacity: 0.58;
    stroke-width: 0.16;
  }

  .sm-star--near {
    filter: drop-shadow(0 0 0.45px rgba(234, 240, 255, 0.45));
  }

  .sm-star--glow {
    filter: url(#sm-blur);
  }

  .sm-core-disc {
    filter: drop-shadow(0 0 0.6px rgba(255, 245, 214, 0.6));
  }

  /* --- orbits ----------------------------------------------------- */
  .sm-orbit {
    fill: none;
    stroke: #3d4f75;
  }

  .sm-orbit--deep {
    stroke-width: 0.11;
    opacity: 0.5;
    stroke-dasharray: 0.6 1.6;
  }

  .sm-orbit--live {
    stroke-width: 0.16;
    opacity: 0.85;
    transition: stroke 0.25s var(--ease), opacity 0.25s var(--ease),
      stroke-width 0.25s var(--ease);
  }

  /* a hairline from the core to every node — the chart's own geometry */
  .sm-spoke {
    stroke: #344363;
    stroke-width: 0.07;
    stroke-dasharray: 0.7 1.4;
    opacity: 0.45;
    transition: stroke 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .sm-fore-lane {
    fill: #0b1226;
    opacity: 0.5;
    filter: url(#sm-blur);
  }

  /* --- travellers ------------------------------------------------- */
  .sm-traveller {
    transform-box: view-box;
    transform-origin: 0 0;
    opacity: 0.9;
    filter: drop-shadow(0 0 0.5px rgba(234, 240, 255, 0.55));
  }

  /* --- nodes ------------------------------------------------------ */
  .starmap__nodes {
    position: absolute;
    inset: 0;
  }

  .starmap__node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
    text-decoration: none;
    color: var(--text-2);
    z-index: 3;
  }

  .starmap__marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    display: grid;
    place-items: center;
  }

  /* a larger, invisible hit area so the node stays tappable */
  .starmap__marker::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
  }

  .starmap__halo {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--tone) 42%, transparent) 0%,
      transparent 68%
    );
    opacity: 0.5;
    transform: scale(0.8);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .starmap__ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--tone);
    border-radius: 50%;
    opacity: 0.85;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .starmap__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--tone) 55%, transparent);
    transition: transform 0.25s var(--ease);
  }

  /* --- labels ----------------------------------------------------- */
  .starmap__label {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }

  .starmap__node--left .starmap__label {
    right: 22px;
    top: 0;
    transform: translateY(-50%);
    align-items: flex-end;
    text-align: right;
  }

  .starmap__node--right .starmap__label {
    left: 22px;
    top: 0;
    transform: translateY(-50%);
    align-items: flex-start;
  }

  .starmap__node--below .starmap__label {
    left: 0;
    top: 22px;
    transform: translateX(-50%);
    align-items: center;
  }

  .starmap__code {
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    color: var(--text-3);
  }

  .starmap__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  .starmap__strip {
    display: inline-flex;
    gap: 2px;
    height: 8px;
  }

  .starmap__strip i {
    width: 17px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.12);
  }

  /* the one-line introduction appears when the node is reached */
  .starmap__note {
    position: absolute;
    top: 30px;
    width: max-content;
    max-width: 22ch;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--text-3);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    pointer-events: none;
  }

  .starmap__node--left .starmap__note {
    right: 8px;
    text-align: right;
  }

  .starmap__node--right .starmap__note {
    left: 8px;
    text-align: left;
  }

  .starmap__node--below .starmap__note {
    left: 50%;
    top: 64px;
    transform: translate(-50%, 4px);
    text-align: center;
  }

  /* --- hover / focus ---------------------------------------------- */
  .starmap__node:hover .starmap__dot,
  .starmap__node:focus-visible .starmap__dot {
    transform: scale(1.35);
  }

  .starmap__node:hover .starmap__ring,
  .starmap__node:focus-visible .starmap__ring {
    transform: scale(1.45);
    opacity: 1;
  }

  .starmap__node:hover .starmap__halo,
  .starmap__node:focus-visible .starmap__halo {
    opacity: 1;
    transform: scale(1.25);
  }

  .starmap__node:hover .starmap__name,
