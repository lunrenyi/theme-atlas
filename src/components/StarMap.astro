  }

  .starmap__node:focus-visible {
    outline: 1px solid var(--quantum);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  /* the orbit that carries the reached node lights up */
  .starmap:has(.starmap__node[data-collection='myth']:hover) .sm-orbit[data-orbit='myth'],
  .starmap:has(.starmap__node[data-collection='porcelain']:hover)
