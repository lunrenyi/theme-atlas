  .starmap:has(.starmap__node[data-collection='rail']:hover) .sm-orbit[data-orbit='rail'],
  .starmap:has(.starmap__node[data-collection='myth']:focus-visible) .sm-orbit[data-orbit='myth'],
  .starmap:has(.starmap__node[data-collection='porcelain']:focus-visible)
