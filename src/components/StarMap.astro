<script>
  /**
   * A very small pointer parallax: the map leans a couple of pixels towards
   * the cursor. It is skipped for touch pointers and for visitors who ask
   * for reduced motion.
   */
  const root = document.querySelector<HTMLElement>('[data-starmap]');

  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    let nextX = 0;
    let nextY = 0;

    const apply = () => {
      frame = 0;
      root.style.setProperty('--px', nextX.toFixed(3));
      root.style.setProperty('--py', nextY.toFixed(3));
    };

    root.addEventListener('pointermove', (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      const box = root.getBoundingClientRect();
      nextX = ((event.clientX - box.left) / box.width - 0.5) * 2;
      nextY = ((event.clientY - box.top) / box.height - 0.5) * 2;
      if (!frame) frame = requestAnimationFrame(apply);
    });

    root.addEventListener('pointerleave', () => {
      nextX = 0;
      nextY = 0;
      if (!frame) frame = requestAnimationFrame(apply);
    });
  }
</script>
