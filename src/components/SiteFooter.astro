---
import { site } from '../site.config';
import { collections } from '../data/collections';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap wrap--wide">
    <div class="site-footer__top">
      <div class="site-footer__intro">
        <p class="eyebrow">{site.edition} · {site.name}</p>
        <p class="site-footer__statement">{site.tagline}</p>
        <p class="site-footer__blurb">{site.description}</p>
      </div>

      <div class="site-footer__cols">
        <div class="site-footer__col">
          <p class="eyebrow">系列</p>
          <ul>
            {
              collections.map((c) => (
                <li>
                  <a href={withBase('/collections#' + c.id)}>{c.title}</a>
                </li>
              ))
            }
            <li><a href={withBase('/collections')}>全部系列</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <p class="eyebrow">项目</p>
          <ul>
            <li><a href={withBase('/about')}>关于本站</a></li>
            <li><a href={withBase(site.fanStatementPath)}>同人创作声明</a></li>
            <li>
              <a href={site.repoUrl} rel="noopener noreferrer" target="_blank">
                GitHub 仓库
                <span class="mono site-footer__ext" aria-hidden="true">↗</span>
              </a>
            </li>
            <li><a href={site.repoUrl + '/issues'} rel="noopener noreferrer" target="_blank">问题反馈</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="mono">© {year} {site.name}. 配色数据以 CC BY 4.0 释出。</p>
      <p class="mono site-footer__note">
        本站与任何游戏厂商无隶属或授权关系；同人主题均为非官方演绎。
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--paper-sunken);
    padding-block: clamp(48px, 6vw, 88px) 32px;
    margin-top: clamp(64px, 8vw, 120px);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .site-footer__statement {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin: 14px 0 18px;
  }

  .site-footer__blurb {
    color: var(--ink-2);
    max-width: 44ch;
    font-size: var(--step-0);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .site-footer__col ul {
    list-style: none;
    margin-top: 14px;
  }

  .site-footer__col li + li {
    margin-top: 9px;
  }

  .site-footer__col a {
    text-decoration: none;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .site-footer__col a:hover {
    color: var(--cinnabar);
  }

  .site-footer__ext {
    font-size: 0.7em;
    margin-left: 3px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: 18px;
    border-top: 1px solid var(--rule-2);
    color: var(--ink-3);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 780px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

