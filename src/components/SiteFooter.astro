---
import { site } from '../site.config';
import { getCollections } from '../lib/content';
import { localePath } from '../lib/url';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const collections = getCollections(lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap wrap--wide">
    <div class="site-footer__top">
      <div class="site-footer__intro">
        <p class="eyebrow eyebrow--gold">
          <span class="site-footer__pulse" aria-hidden="true"></span>
          {site.edition}
        </p>
        <p class="site-footer__statement">{site.tagline}</p>
        <p class="site-footer__blurb">{site.description[lang]}</p>
      </div>

      <div class="site-footer__cols">
        <div class="site-footer__col">
          <p class="eyebrow">{t(lang, 'footer.series')}</p>
          <ul>
            {
              collections.map((c) => (
                <li>
                  <a href={localePath('/collections#' + c.id, lang)}>{c.title}</a>
                </li>
              ))
            }
            <li><a href={localePath('/collections', lang)}>{t(lang, 'footer.allCollections')}</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <p class="eyebrow">{t(lang, 'footer.project')}</p>
          <ul>
            <li><a href={localePath('/about', lang)}>{t(lang, 'footer.about')}</a></li>
            <li><a href={localePath(site.fanStatementPath, lang)}>{t(lang, 'footer.fanStatement')}</a></li>
            <li>
              <a href={site.repoUrl} rel="noopener noreferrer" target="_blank">
                {t(lang, 'footer.repo')}
                <span class="mono site-footer__ext" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href={site.repoUrl + '/issues'} rel="noopener noreferrer" target="_blank">
                {t(lang, 'footer.issues')}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="mono">© {year} {site.name} · {t(lang, 'footer.licence')}</p>
      <p class="mono site-footer__note">
        {t(lang, 'footer.disclaimer')}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--orbit-faint);
    background: color-mix(in srgb, var(--space-2) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding-block: clamp(48px, 6vw, 88px) 32px;
    margin-top: clamp(56px, 7vw, 112px);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .site-footer__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--glow) 20%, transparent);
    flex: none;
  }

  .site-footer__statement {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin: 16px 0 18px;
    color: var(--text);
  }

  .site-footer__blurb {
    color: var(--text-2);
    max-width: 44ch;
    font-size: var(--step-0);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .site-footer__col ul {
    list-style: none;
    margin-top: 14px;
  }

  .site-footer__col li + li {
    margin-top: 9px;
  }

  .site-footer__col a {
    text-decoration: none;
    color: var(--text-2);
    font-size: var(--step--1);
  }

  .site-footer__col a:hover {
    color: var(--gold);
  }

  .site-footer__ext {
    font-size: 0.7em;
    margin-left: 3px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: 18px;
    border-top: 1px solid var(--orbit-faint);
    color: var(--text-3);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 780px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

