---
import { nav, site } from '../site.config';
import { withBase } from '../lib/url';
import { themes } from '../data/themes';

const path = Astro.url.pathname.replace(withBase('/') === '/' ? '' : withBase('/'), '');
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  if (href.startsWith('/#')) return false;
  return path.startsWith(href);
};
const total = themes.length;
---

<header class="site-header" data-header>
  <div class="wrap wrap--wide site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={site.name + ' 首页'}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" fill="none">
        <ellipse cx="16" cy="16" rx="13" ry="5" stroke="currentColor" stroke-width="1.1" opacity="0.55" transform="rotate(-24 16 16)"></ellipse>
        <ellipse cx="16" cy="16" rx="13" ry="5" stroke="currentColor" stroke-width="1.1" opacity="0.35" transform="rotate(48 16 16)"></ellipse>
        <circle cx="16" cy="16" r="3.1" fill="currentColor"></circle>
        <circle cx="27.2" cy="11.6" r="1.5" fill="currentColor"></circle>
      </svg>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__zh">{site.nameZh}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <span class="site-nav__zh">{item.zh}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <p class="catalog mono" aria-label={'共 ' + total + ' 套主题'}>
        <span class="catalog__label">CATALOG</span>
        <span class="catalog__value">{String(total).padStart(3, '0')}</span>
      </p>

      <form class="header-search" role="search" data-header-search>
        <svg class="field__icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        <label class="sr-only" for="header-search-input">搜索主题</label>
        <input
          id="header-search-input"
          type="search"
          name="q"
          placeholder="搜索主题、颜色或关键词"
          autocomplete="off"
          data-global-search
        />
      </form>

      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-panel"
        data-menu-toggle
      >
        <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="sr-only">打开菜单</span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-panel" hidden data-mobile-panel>
    <div class="wrap">
      <form class="field" role="search" data-header-search>
        <svg class="field__icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        <label class="sr-only" for="mobile-search-input">搜索主题</label>
        <input
          id="mobile-search-input"
          type="search"
          name="q"
          placeholder="搜索主题、颜色或关键词"
          autocomplete="off"
          data-global-search
        />
      </form>
      <ul class="mobile-panel__nav">
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)}>
                <span>{item.label}</span>
                <span class="mono">{item.zh}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  // --- mobile menu -------------------------------------------------
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  }

  // --- global search ------------------------------------------------
  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-global-search]'));
  const home = document.querySelector<HTMLInputElement>('[data-library-search]');

  function applyToLibrary(value: string) {
    if (!home) return;
    if (home.value !== value) {
      home.value = value;
      home.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  inputs.forEach((input) => {
    input.addEventListener('input', () => {
      const value = input.value;
      // keep the two header fields in sync
      inputs.forEach((other) => {
        if (other !== input && other.value !== value) other.value = value;
      });
      if (home) {
        applyToLibrary(value);
      }
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      if (home) {
        applyToLibrary(input.value);
        home.scrollIntoView({ block: 'center' });
        home.focus({ preventScroll: true });
      } else {
        const target = new URL(window.location.origin + import.meta.env.BASE_URL);
        target.searchParams.set('q', input.value);
        target.hash = 'themes';
        window.location.href = target.toString();
      }
    });
  });

  // the library tells the header what the current query is
  document.addEventListener('atlas:search-changed', (event) => {
    const detail = (event as CustomEvent<{ query: string }>).detail;
    inputs.forEach((input) => {
      if (input.value !== detail.query) input.value = detail.query;
    });
  });

  // prefill from ?q=
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('q');
  if (initial && home) {
    home.value = initial;
    home.dispatchEvent(new Event('input', { bubbles: true }));
    inputs.forEach((input) => (input.value = initial));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--space) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--orbit-faint);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex: none;
  }

  .brand__mark {
    width: 26px;
    height: 26px;
    color: var(--gold);
    flex: none;
  }

  .brand:hover .brand__mark {
    color: var(--glow);
  }

  .brand__text {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.16rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .brand__zh {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    color: var(--text-3);
  }

  .site-nav {
    flex: 1;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(14px, 2.2vw, 28px);
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .site-nav__link:hover {
    color: var(--text);
    border-bottom-color: var(--orbit);
  }

  .site-nav__link.is-active {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .site-nav__zh {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
    text-transform: none;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }

  /* real data, not decoration */
  .catalog {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--text-3);
    padding-right: 16px;
    border-right: 1px solid var(--orbit-faint);
  }

  .catalog__value {
    color: var(--glow);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  .header-search {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--orbit-dim);
    padding: 5px 2px;
    width: clamp(140px, 16vw, 200px);
    transition: border-color 0.18s var(--ease);
  }

  .header-search:focus-within {
    border-bottom-color: var(--quantum);
  }

  .header-search input {
    border: 0;
    background: transparent;
    outline: none;
    width: 100%;
    font-size: 0.78rem;
    padding: 2px 0;
  }

  .header-search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--orbit-dim);
    background: transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .menu-toggle__bars {
    display: block;
    width: 16px;
  }

  .menu-toggle__bars i {
    display: block;
    height: 1.5px;
    background: var(--text-2);
    margin: 4px 0;
  }

  .mobile-panel {
    border-top: 1px solid var(--orbit-faint);
    background: var(--space-2);
    padding: 18px 0 22px;
  }

  .mobile-panel__nav {
    list-style: none;
    margin-top: 14px;
  }

  .mobile-panel__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 11px 0;
    border-top: 1px solid var(--orbit-faint);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-panel__nav .mono {
    font-size: 0.72rem;
    color: var(--text-3);
    letter-spacing: 0.1em;
  }

  @media (max-width: 1020px) {
    .catalog {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-search {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }
</style>

