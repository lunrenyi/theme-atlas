---
import type { Theme } from '../data/types';
import { getCollection } from '../data/collections';
import { arrangementFor, arrangePalette } from '../lib/arrangement';
import { withBase } from '../lib/url';
import PaletteStrip from './PaletteStrip.astro';

interface Props {
  theme: Theme;
  variant?: 'grid' | 'featured';
  /** Show the long description instead of the short subtitle. */
  showDescription?: boolean;
}

const { theme, variant = 'grid', showDescription = variant === 'featured' } = Astro.props;

const collection = getCollection(theme.collection);
const rule = arrangementFor(theme.collection);
const palette = arrangePalette(theme);

const statusMap = {
  verified: { label: '来源可核验', tone: 'ok' },
  interpretation: { label: '同人演绎', tone: 'fan' },
  draft: { label: '待补充', tone: 'warn' },
} as const;
const status = statusMap[theme.status];
---

<article class:list={['card', 'card--' + variant]} data-collection={theme.collection}>
  <div class="card__meta">
    <a class="card__collection mono" href={withBase('/collections#' + collection.id)}>
      <span class="card__swatch" style={'--tone:' + collection.accent} aria-hidden="true"></span>
      {collection.title}
    </a>
    {
      theme.status !== 'verified' && (
        <span class:list={['card__status', 'card__status--' + status.tone]}>{status.label}</span>
      )
    }
  </div>

  <h3 class="card__title">
    <a class="card__link" href={withBase('/theme/' + theme.slug)}>{theme.title}</a>
  </h3>

  {
    showDescription && (
      <p class="card__desc">{theme.description}</p>
    )
  }

  <PaletteStrip palette={palette} variant={variant === 'featured' ? 'hero' : 'card'} />

  <ul class="card__names">
    {palette.map((c) => <li class="mono">{c.name}</li>)}
  </ul>

  {
    !showDescription && (
      <p class="card__caption">{theme.subtitle}</p>
    )
  }

  <div class="card__foot">
    <span class="card__rule mono">{rule.label}</span>
    <span class="card__diagram" aria-hidden="true">
      {
        palette.map((c) => (
          <i
            class:list={{ 'is-accent': c.role === 'accent' }}
            style={'--tone:' + c.hex}
          />
        ))
      }
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 20px 20px 16px;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease);
  }

  .card:hover {
    border-color: var(--rule-strong);
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 20px;
  }

  .card__collection {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
  }

  .card__collection:hover {
    color: var(--ink);
  }

  .card__swatch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone);
    flex: none;
  }

  .card__status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--rule-2);
    border-radius: 2px;
    padding: 2px 6px;
    white-space: nowrap;
  }

  .card__status--fan {
    border-color: color-mix(in srgb, var(--gold) 50%, transparent);
    color: var(--gold);
  }

  .card__status--warn {
    border-color: color-mix(in srgb, var(--cinnabar) 40%, transparent);
    color: var(--cinnabar);
  }

  .card__title {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .card__link {
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card__link:hover {
    color: var(--cinnabar);
  }

  .card__desc {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
    max-width: 42ch;
  }

  .card__names {
    display: flex;
    flex-wrap: wrap;
    gap: 1px 8px;
    list-style: none;
    font-size: 0.63rem;
    letter-spacing: 0.03em;
    color: var(--ink-3);
  }

  .card__names li + li::before {
    content: '·';
    margin-right: 8px;
    opacity: 0.5;
  }

  .card__caption {
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .card__rule {
    color: var(--ink-2);
    white-space: nowrap;
  }

  /* a diagram of the rule: seven cells in the order this collection reads */
  .card__diagram {
    display: inline-flex;
    gap: 2px;
  }

  .card__diagram i {
    width: 13px;
    height: 9px;
    background: var(--tone);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.12);
  }

  .card__diagram i.is-accent {
    outline: 1px solid var(--ink);
    outline-offset: 1px;
  }

  /* --- featured row variant ---------------------------------- */
  .card--featured {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'head head'
      'title strip'
      'desc strip'
      'names strip'
      'foot foot';
    column-gap: clamp(24px, 4vw, 64px);
    row-gap: 10px;
    align-items: start;
    padding: clamp(24px, 3vw, 38px);
  }

  .card--featured .card__meta {
    grid-area: head;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }

  .card--featured .card__title {
    grid-area: title;
    font-size: var(--step-3);
  }

  .card--featured .card__desc {
    grid-area: desc;
  }

  .card--featured .card__names {
    grid-area: names;
  }

  .card--featured :global(.strip-wrap) {
    grid-area: strip;
    align-self: center;
  }

  .card--featured .card__foot {
    grid-area: foot;
  }

  .card--featured .card__diagram i {
    width: 18px;
    height: 10px;
  }

  @media (max-width: 820px) {
    .card--featured {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'title'
        'desc'
        'strip'
        'names'
        'foot';
    }
  }
</style>

