---
import type { Theme } from '../data/types';
import { getCollections, getGameWorlds } from '../lib/content';
import { t, type Locale } from '../i18n';
import ThemeCard from './ThemeCard.astro';

interface Props {
  themes: Theme[];
  lang: Locale;
}

const { themes, lang } = Astro.props;
const collections = getCollections(lang);
const collectionById = new Map(collections.map((collection) => [collection.id, collection]));
const gameWorlds = getGameWorlds(lang);
const gameWorldById = new Map(gameWorlds.map((game) => [game.id, game]));
const countFor = (id: string) =>
  id === 'all' ? themes.length : themes.filter((theme) => theme.collection === id).length;

const searchText = (theme: Theme) => {
  const collection = collectionById.get(theme.collection);
  const gameWorld = theme.game ? gameWorldById.get(theme.game) : undefined;
  return [
    theme.slug,
    theme.title,
    theme.subtitle,
    theme.description,
    theme.story,
    theme.inspiration,
    theme.tags.join(' '),
    collection?.title,
    collection?.short,
    collection?.tagline,
    collection?.description,
    gameWorld?.title,
    gameWorld?.short,
    gameWorld?.tagline,
    gameWorld?.description,
    theme.palette.map((color) => [color.name, color.hex, color.note].filter(Boolean).join(' ')).join(' '),
  ]
    .filter(Boolean)
    .join(' ')
    .normalize('NFKC')
    .toLocaleLowerCase(lang === 'zh' ? 'zh-CN' : 'en-US');
};
---

<div
  class="library"
  id="themes-directory"
  data-library
  data-locale={lang === 'zh' ? 'zh-CN' : 'en-US'}
  data-count-width={lang === 'zh' ? '2' : '3'}
>
  <div class="library__toolbar">
    <div class="field library__search">
      <svg class="field__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
        <path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
      <label class="sr-only" for="themes-search">{t(lang, 'library.searchLabel')}</label>
      <input
        id="themes-search"
        type="search"
        name="q"
        placeholder={t(lang, 'library.searchPlaceholder')}
        autocomplete="off"
        data-library-search
      />
      <button type="button" class="library__clear" data-library-clear hidden>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 2 L10 10 M10 2 L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <span class="sr-only">{t(lang, 'library.clearSearch')}</span>
      </button>
    </div>

    <label class="library__sort">
      <span>{t(lang, 'library.sortLabel')}</span>
      <select data-library-sort>
        <option value="default">{t(lang, 'library.sortDefault')}</option>
        <option value="name">{t(lang, 'library.sortName')}</option>
      </select>
    </label>
  </div>

  <div class="library__filters" role="group" aria-label={t(lang, 'library.filterLabel')}>
    <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
      <span>{t(lang, 'library.filterAll')}</span>
      <span class="chip__count mono">{countFor('all')}</span>
    </button>
    {
      collections.map((collection) => (
        <button type="button" class="chip" data-filter={collection.id} aria-pressed="false">
          <span class="chip__dot" style={'--tone:' + collection.accent} aria-hidden="true" />
          <span>{collection.title}</span>
          <span class="chip__count mono">{countFor(collection.id)}</span>
        </button>
      ))
    }
  </div>

  <div class="library__status">
    <p
      class="library__count mono"
      data-library-count
      data-count-template={t(lang, 'library.count')}
      aria-live="polite"
    >
    </p>
    <button type="button" class="library__clear-all" data-library-clear-all hidden>
      {t(lang, 'library.clearFilters')}
    </button>
  </div>

  <div class="library__grid" data-library-grid>
    {
      themes.map((theme) => (
        <div
          class="library__item"
          data-library-item
          data-collection={theme.collection}
          data-sort-name={theme.title}
          data-search={searchText(theme)}
        >
          <ThemeCard theme={theme} lang={lang} />
        </div>
      ))
    }
  </div>

  <div class="library__empty" data-library-empty hidden>
    <svg viewBox="0 0 140 96" aria-hidden="true" class="library__empty-art">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <circle cx="62" cy="48" r="34" stroke-dasharray="3 5" opacity="0.45"></circle>
        <ellipse cx="62" cy="48" rx="44" ry="16" transform="rotate(-18 62 48)" opacity="0.35"></ellipse>
        <path d="M62 12v72M26 48h72" stroke-dasharray="2 5" opacity="0.2"></path>
      </g>
      <circle cx="96" cy="26" r="3" fill="currentColor" opacity="0.55"></circle>
      <circle cx="32" cy="68" r="2" fill="currentColor" opacity="0.4"></circle>
      <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.85">
        <circle cx="98" cy="60" r="13"></circle>
        <path d="M107 69l10 10" stroke-linecap="round"></path>
      </g>
    </svg>
    <p class="library__empty-title">{t(lang, 'library.emptyTitle')}</p>
    <p class="library__empty-text">{t(lang, 'library.emptyText')}</p>
    <button type="button" class="btn btn--ghost btn--sm" data-library-reset>
      {t(lang, 'library.reset')}
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-library]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-library-search]');
    const clearSearchBtn = root.querySelector<HTMLButtonElement>('[data-library-clear]');
    const clearAllBtn = root.querySelector<HTMLButtonElement>('[data-library-clear-all]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-library-reset]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-library-sort]');
    const countEl = root.querySelector<HTMLElement>('[data-library-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-library-empty]');
    const grid = root.querySelector<HTMLElement>('[data-library-grid]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-library-item]'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const collator = new Intl.Collator(root.dataset.locale ?? 'en-US', {
      sensitivity: 'base',
      numeric: true,
    });
    const countWidth = Number(root.dataset.countWidth ?? 2);

    let query = '';
    let collection = 'all';
    let sort = 'default';

    const normalize = (value: string) =>
      value.normalize('NFKC').trim().toLocaleLowerCase(root.dataset.locale);

    function applySort() {
      if (!grid) return;
      const ordered = [...items];
      if (sort === 'name') {
        ordered.sort((a, b) =>
          collator.compare(a.dataset.sortName ?? '', b.dataset.sortName ?? ''),
        );
      }
      ordered.forEach((item) => grid.append(item));
    }

    function applyFilters() {
      const terms = normalize(query).split(/\s+/).filter(Boolean);
      let visible = 0;

      items.forEach((item) => {
        const haystack = item.dataset.search ?? '';
        const matchText = terms.every((term) => haystack.includes(term));
        const matchCollection =
          collection === 'all' || item.dataset.collection === collection;
        const show = matchText && matchCollection;
        item.hidden = !show;
        if (show) visible += 1;
      });

      if (countEl) {
        const template = countEl.dataset.countTemplate ?? '';
        countEl.textContent = template
          .replace('{shown}', String(visible).padStart(countWidth, '0'))
          .replace('{total}', String(items.length).padStart(countWidth, '0'));
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (clearSearchBtn) clearSearchBtn.hidden = query.length === 0;
      if (clearAllBtn) clearAllBtn.hidden = query.length === 0 && collection === 'all';

      chips.forEach((chip) => {
        const active = chip.dataset.filter === collection;
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', String(active));
      });

      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (collection !== 'all') url.searchParams.set('c', collection);
      else url.searchParams.delete('c');
      if (sort !== 'default') url.searchParams.set('sort', sort);
      else url.searchParams.delete('sort');
      history.replaceState({}, '', url.toString());
    }

    function resetFilters() {
      if (input) input.value = '';
      query = '';
      collection = 'all';
      applyFilters();
      input?.focus();
    }

    input?.addEventListener('input', () => {
      query = input.value;
      applyFilters();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        collection = chip.dataset.filter ?? 'all';
        applyFilters();
      });
    });

    sortSelect?.addEventListener('change', () => {
      sort = sortSelect.value;
      applySort();
      applyFilters();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      query = '';
      applyFilters();
      input.focus();
    });

    clearAllBtn?.addEventListener('click', resetFilters);
    resetBtn?.addEventListener('click', resetFilters);

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') ?? '';
    const initialCollection = params.get('c');
    const initialSort = params.get('sort');

    if (initialQuery && input) {
      input.value = initialQuery;
      query = initialQuery;
    }
    if (initialCollection && chips.some((chip) => chip.dataset.filter === initialCollection)) {
      collection = initialCollection;
    }
    if (initialSort === 'name' && sortSelect) {
      sort = initialSort;
      sortSelect.value = initialSort;
    }

    applySort();
    applyFilters();

    if (params.get('focus') === 'search' || initialQuery) {
      requestAnimationFrame(() => {
        input?.focus({ preventScroll: true });
        const clean = new URL(window.location.href);
        clean.searchParams.delete('focus');
        history.replaceState({}, '', clean.toString());
      });
    }
  }
</script>

<style>
  .library__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 16px;
  }

  .library__search {
    flex: 1 1 440px;
    max-width: 720px;
    min-height: 48px;
    padding-inline: 15px;
  }

  .library__clear {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: 0;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    border-radius: 50%;
  }

  .library__clear[hidden] {
    display: none;
  }

  .library__clear:hover {
    color: var(--gold);
    background: var(--panel-2);
  }

  .library__sort {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .library__sort select {
    min-height: 38px;
    padding: 7px 30px 7px 10px;
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    background: var(--space-2);
    color: var(--text-2);
    cursor: pointer;
  }

  .library__sort select:hover,
  .library__sort select:focus-visible {
    border-color: var(--quantum);
  }

  .library__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border: 1px solid var(--orbit-dim);
    background: transparent;
    color: var(--text-2);
    border-radius: var(--radius-sm);
    font-size: 0.76rem;
    cursor: pointer;
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease),
      background 0.16s var(--ease);
  }

  .chip:hover {
    border-color: var(--orbit);
    color: var(--text);
  }

  .chip.is-active {
    background: color-mix(in srgb, var(--gold) 10%, transparent);
    border-color: var(--gold);
    color: var(--gold);
  }

  .chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
  }

  .chip__count {
    font-size: 0.66rem;
    opacity: 0.65;
  }

  .library__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 18px 0 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--orbit-faint);
  }

  .library__count {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .library__clear-all {
    border: 0;
    border-bottom: 1px solid var(--orbit);
    background: transparent;
    padding: 2px 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .library__clear-all[hidden] {
    display: none;
  }

  .library__clear-all:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px 24px;
  }

  .library__item[hidden] {
    display: none;
  }

  .library__empty {
    padding: clamp(40px, 6vw, 80px) 20px;
    text-align: center;
    border: 1px dashed var(--orbit-dim);
    border-radius: var(--radius);
    color: var(--text-3);
  }

  .library__empty[hidden] {
    display: none;
  }

  .library__empty-art {
    width: 140px;
    margin: 0 auto 18px;
    color: var(--text-3);
  }

  .library__empty-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text);
    margin-bottom: 8px;
  }

  .library__empty-text {
    max-width: 40ch;
    margin: 0 auto 22px;
    font-size: var(--step--1);
  }

  @media (max-width: 1080px) {
    .library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .library__toolbar {
      align-items: stretch;
    }

    .library__search {
      flex-basis: 100%;
      max-width: none;
    }

    .library__sort {
      justify-content: space-between;
    }

    .library__grid {
      grid-template-columns: 1fr;
    }

    .library__status {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
