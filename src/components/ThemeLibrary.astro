---
import type { Theme } from '../data/types';
import { collections } from '../data/collections';
import ThemeCard from './ThemeCard.astro';

interface Props {
  themes: Theme[];
  /** Hide the collection filter row (used on the collections page). */
  showFilters?: boolean;
}

const { themes, showFilters = true } = Astro.props;
const countFor = (id: string) =>
  id === 'all' ? themes.length : themes.filter((t) => t.collection === id).length;
---

<div class="library" data-library>
  <div class="library__toolbar">
    <div class="field library__search">
      <svg class="field__icon" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
        <path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
      <label class="sr-only" for="library-search">搜索主题</label>
      <input
        id="library-search"
        type="search"
        placeholder="按名称、灵感、颜色或关键词搜索"
        autocomplete="off"
        data-library-search
      />
      <button type="button" class="library__clear" data-library-clear hidden>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 2 L10 10 M10 2 L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <span class="sr-only">清除搜索</span>
      </button>
    </div>

    {
      showFilters && (
        <div class="library__filters" role="group" aria-label="按系列筛选主题">
          <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
            <span>全部</span>
            <span class="chip__count mono">{countFor('all')}</span>
          </button>
          {collections.map((c) => (
            <button type="button" class="chip" data-filter={c.id} aria-pressed="false">
              <span class="chip__dot" style={'--tone:' + c.accent} aria-hidden="true" />
              <span>{c.title}</span>
              <span class="chip__count mono">{countFor(c.id)}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  <p class="library__count mono" data-library-count aria-live="polite"></p>

  <div class="library__grid" data-library-grid>
    {
      themes.map((theme) => (
        <div
          class="library__item"
          data-library-item
          data-collection={theme.collection}
          data-search={[
            theme.title,
            theme.subtitle,
            theme.description,
            theme.tags.join(' '),
            theme.palette.map((c) => c.name + ' ' + c.hex).join(' '),
          ]
            .join(' ')
            .toLowerCase()}
        >
          <ThemeCard theme={theme} />
        </div>
      ))
    }
  </div>

  <div class="library__empty" data-library-empty hidden>
    <svg viewBox="0 0 120 80" aria-hidden="true" class="library__empty-art">
      <rect x="6" y="14" width="108" height="54" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4"></rect>
      <rect x="16" y="24" width="22" height="34" fill="currentColor" opacity="0.12"></rect>
      <rect x="42" y="24" width="22" height="34" fill="currentColor" opacity="0.2"></rect>
      <rect x="68" y="24" width="22" height="34" fill="currentColor" opacity="0.3"></rect>
      <circle cx="96" cy="41" r="8" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5"></circle>
      <path d="M102 47 L108 53" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.5"></path>
    </svg>
    <p class="library__empty-title">没有匹配的主题</p>
    <p class="library__empty-text">
      换一个关键词试试，或者看看全部系列。也可以只按颜色名搜索，例如“天青”或“朱砂”。
    </p>
    <button type="button" class="btn btn--ghost btn--sm" data-library-reset>重置筛选</button>
  </div>
</div>

<script>
  const root = document.querySelector('[data-library]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-library-search]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-library-clear]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-library-reset]');
    const countEl = root.querySelector<HTMLElement>('[data-library-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-library-empty]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-library-item]'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    let query = '';
    let collection = 'all';

    function apply() {
      let visible = 0;
      items.forEach((item) => {
        const matchText =
          !query || (item.dataset.search ?? '').includes(query);
        const matchCollection =
          collection === 'all' || item.dataset.collection === collection;
        const show = matchText && matchCollection;
        item.hidden = !show;
        if (show) visible += 1;
      });

      if (countEl) {
        countEl.textContent =
          '显示 ' + String(visible).padStart(2, '0') + ' / ' + String(items.length).padStart(2, '0') + ' 套主题';
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (clearBtn) clearBtn.hidden = query.length === 0;

      chips.forEach((chip) => {
        const active = chip.dataset.filter === collection;
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', String(active));
      });

      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (collection !== 'all') url.searchParams.set('c', collection);
      else url.searchParams.delete('c');
      history.replaceState({}, '', url.toString());

      document.dispatchEvent(
        new CustomEvent('atlas:search-changed', { detail: { query, collection } }),
      );
    }

    input?.addEventListener('input', () => {
      query = input.value.trim().toLowerCase();
      apply();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        collection = chip.dataset.filter ?? 'all';
        apply();
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      query = '';
      apply();
      input.focus();
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      query = '';
      collection = 'all';
      apply();
    });

    // initial state from the URL
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    const c = params.get('c');
    if (q && input) {
      input.value = q;
      query = q.trim().toLowerCase();
    }
    if (c && chips.some((chip) => chip.dataset.filter === c)) {
      collection = c;
    }
    apply();
  }
</script>

<style>
  .library__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .library__search {
    flex: 1 1 260px;
    max-width: 380px;
  }

  .library__clear {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 0;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    border-radius: 50%;
  }

  .library__clear[hidden] {
    display: none;
  }

  .library__clear:hover {
    color: var(--cinnabar);
    background: var(--paper-sunken);
  }

  .library__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--rule-2);
    background: transparent;
    color: var(--ink-2);
    border-radius: var(--radius);
    font-size: 0.76rem;
    cursor: pointer;
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease),
      background 0.16s var(--ease);
  }

  .chip:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ink-invert);
  }

  .chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
  }

  .chip.is-active .chip__dot {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .chip__count {
    font-size: 0.66rem;
    opacity: 0.6;
  }

  .library__count {
    margin: 16px 0 22px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .library__item[hidden] {
    display: none;
  }

  .library__empty {
    padding: clamp(40px, 6vw, 80px) 20px;
    text-align: center;
    border: 1px dashed var(--rule-2);
    border-radius: var(--radius);
    color: var(--ink-3);
  }

  @media (max-width: 1080px) {
    .library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .library__grid {
      grid-template-columns: 1fr;
    }
  }

  .library__empty-art {
    width: 120px;
    margin: 0 auto 18px;
    color: var(--ink-3);
  }

  .library__empty-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
    margin-bottom: 8px;
  }

  .library__empty-text {
    max-width: 40ch;
    margin: 0 auto 22px;
    font-size: var(--step--1);
  }
</style>

