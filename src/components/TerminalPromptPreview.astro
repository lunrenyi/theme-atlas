---
import type { Theme } from '../data/types';
import { t, type Locale } from '../i18n';

interface Props {
  theme: Theme;
  lang: Locale;
}

const { theme, lang } = Astro.props;
const user = 'dev';
const host = 'atlas';
const directory = '~/theme-atlas';
const branch = 'main';
---

<div
  class="terminal-preview"
  data-terminal-preview
  data-theme={theme.slug}
  data-layout="single"
  data-git="on"
>
  <div class="terminal-preview__controls">
    <div
      class="terminal-preview__layout"
      role="group"
      aria-label={t(lang, 'preview.terminalLayoutLabel')}
    >
      <span class="terminal-preview__control-label mono">
        {t(lang, 'preview.terminalLayoutLabel')}
      </span>
      <button
        type="button"
        class="terminal-preview__button is-active"
        data-terminal-layout="single"
        aria-pressed="true"
        title={t(lang, 'preview.terminalSingleTitle')}
      >
        {t(lang, 'preview.terminalSingle')}
      </button>
      <button
        type="button"
        class="terminal-preview__button"
        data-terminal-layout="double"
        aria-pressed="false"
        title={t(lang, 'preview.terminalDoubleTitle')}
      >
        {t(lang, 'preview.terminalDouble')}
      </button>
    </div>

    <label class="terminal-preview__git-toggle">
      <input type="checkbox" data-terminal-git checked />
      <span title={t(lang, 'preview.terminalShowGitTitle')}>
        {t(lang, 'preview.terminalShowGit')}
      </span>
    </label>
  </div>

  <figure class="terminal-window" aria-label={t(lang, 'preview.terminalWindowLabel')}>
    <div class="terminal-window__bar">
      <span class="terminal-window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="terminal-window__title mono">{t(lang, 'preview.terminalTitle')}</span>
      <span class="terminal-window__subtitle mono">{t(lang, 'preview.terminalSubtitle')}</span>
    </div>

    <div class="terminal-window__screen">
      <div
        class="terminal-prompt"
        role="img"
        aria-label="dev@atlas ~/theme-atlas git:(main) ❯"
      >
        <span class="terminal-prompt__context">
          <span class="terminal-prompt__user-host">
            <span class="terminal-prompt__user">{user}</span><span class="terminal-prompt__at">@</span><span class="terminal-prompt__host">{host}</span>
          </span>
          <span class="terminal-prompt__path">{directory}</span>
        </span>
        <span class="terminal-prompt__git">
          <span class="terminal-prompt__muted">git:(</span><span class="terminal-prompt__branch">{branch}</span><span class="terminal-prompt__muted">)</span>
        </span>
        <span class="terminal-prompt__entry">
          <span class="terminal-prompt__symbol" aria-hidden="true">❯</span>
          <span class="terminal-prompt__cursor" aria-hidden="true"></span>
        </span>
      </div>
    </div>
  </figure>

  <p class="terminal-preview__note">{t(lang, 'preview.terminalNote')}</p>
</div>

<script>
  const terminals = Array.from(document.querySelectorAll<HTMLElement>('[data-terminal-preview]'));

  terminals.forEach((terminal) => {
    const layoutButtons = Array.from(
      terminal.querySelectorAll<HTMLButtonElement>('[data-terminal-layout]'),
    );
    const gitToggle = terminal.querySelector<HTMLInputElement>('[data-terminal-git]');
    const prompt = terminal.querySelector<HTMLElement>('.terminal-prompt');

    const setLayout = (layout: string) => {
      terminal.dataset.layout = layout;
      layoutButtons.forEach((button) => {
        const active = button.dataset.terminalLayout === layout;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    layoutButtons.forEach((button) => {
      button.addEventListener('click', () => setLayout(button.dataset.terminalLayout ?? 'single'));
    });

    const setGit = () => {
      terminal.dataset.git = gitToggle?.checked ? 'on' : 'off';
      prompt?.setAttribute(
        'aria-label',
        'dev@atlas ~/theme-atlas' + (gitToggle?.checked ? ' git:(main)' : '') + ' ❯',
      );
    };
    gitToggle?.addEventListener('change', setGit);
    setGit();
  });
</script>

<style>
  .terminal-preview {
    min-width: 0;
  }

  .terminal-preview__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-bottom: 12px;
  }

  .terminal-preview__layout {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .terminal-preview__control-label {
    margin-right: 4px;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .terminal-preview__button {
    min-height: 30px;
    padding: 4px 10px;
    border: 1px solid var(--orbit-dim);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .terminal-preview__button:hover {
    border-color: var(--orbit);
    color: var(--text);
  }

  .terminal-preview__button.is-active {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, transparent);
    color: var(--gold);
  }

  .terminal-preview__git-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .terminal-preview__git-toggle input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--gold);
  }

  .terminal-window {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--t-border);
    border-radius: var(--radius);
    background: var(--t-bg);
    color: var(--t-text);
  }

  .terminal-window__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 7px 11px;
    border-bottom: 1px solid var(--t-border);
    background: var(--t-surface);
  }

  .terminal-window__dots {
    display: inline-flex;
    flex: none;
    gap: 4px;
  }

  .terminal-window__dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--t-muted);
    opacity: 0.45;
  }

  .terminal-window__title {
    color: var(--t-text);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .terminal-window__subtitle {
    margin-left: auto;
    color: var(--t-muted);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .terminal-window__screen {
    min-width: 0;
    padding: clamp(18px, 3.4vw, 28px);
    background: var(--t-bg);
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .terminal-prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1rem;
    min-width: 0;
    color: var(--t-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: clamp(0.78rem, 2.2vw, 0.92rem);
    line-height: 1.65;
    letter-spacing: -0.01em;
  }

  .terminal-prompt__context {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.15rem;
    min-width: 0;
  }

  .terminal-prompt__user-host,
  .terminal-prompt__path,
  .terminal-prompt__git {
    overflow-wrap: anywhere;
  }

  .terminal-prompt__user,
  .terminal-prompt__branch,
  .terminal-prompt__symbol {
    color: var(--t-accent);
    font-weight: 650;
  }

  .terminal-prompt__at,
  .terminal-prompt__muted {
    color: var(--t-muted);
  }

  .terminal-prompt__host,
  .terminal-prompt__path {
    color: var(--t-text);
  }

  .terminal-prompt__entry {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    min-width: 0;
  }

  .terminal-prompt__cursor {
    display: inline-block;
    width: 0.52em;
    height: 1.05em;
    border-left: 1px solid var(--t-text);
    transform: translateY(0.15em);
    opacity: 0.82;
  }

  .terminal-preview[data-layout='double'] .terminal-prompt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    row-gap: 0.55rem;
  }

  .terminal-preview[data-layout='double'] .terminal-prompt__context {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .terminal-preview[data-layout='double'] .terminal-prompt__git {
    grid-column: 1;
    grid-row: 2;
  }

  .terminal-preview[data-layout='double'] .terminal-prompt__entry {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }

  .terminal-preview[data-git='off'] .terminal-prompt__git {
    display: none;
  }

  .terminal-preview[data-layout='double'][data-git='off'] .terminal-prompt__entry {
    grid-column: 1;
    justify-self: start;
  }

  .terminal-preview__note {
    margin-top: 9px;
    color: var(--text-3);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  @media (max-width: 520px) {
    .terminal-preview__controls {
      align-items: flex-start;
      flex-direction: column;
    }

    .terminal-window__screen {
      padding: 16px 14px;
    }

    .terminal-prompt {
      gap: 0.45rem 0.75rem;
      font-size: 0.79rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-preview__button {
      transition: none;
    }
  }
</style>
