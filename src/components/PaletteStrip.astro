---
import type { PaletteColor } from '../data/types';

interface Props {
  palette: PaletteColor[];
  /** Height / density of the strip. */
  variant?: 'card' | 'hero' | 'detail';
  class?: string;
}

const { palette, variant = 'card', class: className = '' } = Astro.props;
const summary = palette.map((c) => c.name + ' ' + c.hex).join('，');
---

<div class:list={['strip-wrap', className]}>
  <div
    class:list={['strip', 'strip--' + variant]}
    role="img"
    aria-label={'配色条：' + summary}
  >
    {
      palette.map((c) => (
        <span
          class="strip__swatch"
          style={'--swatch:' + c.hex}
          data-label={c.name + ' · ' + c.hex}
          data-role={c.role}
        />
      ))
    }
  </div>
</div>

<style>
  .strip {
    display: flex;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .strip__swatch {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    background: var(--swatch);
  }

  .strip--card .strip__swatch {
    height: 86px;
  }

  .strip--hero .strip__swatch {
    height: clamp(84px, 10vw, 132px);
  }

  .strip--detail .strip__swatch {
    height: 64px;
  }

  .strip__swatch::after {
    content: attr(data-label);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translate(-50%, 4px);
    padding: 5px 9px;
    background: var(--panel-3);
    color: var(--text);
    border: 1px solid var(--orbit);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease);
    z-index: 3;
  }

  .strip__swatch:hover::after,
  .strip__swatch:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

