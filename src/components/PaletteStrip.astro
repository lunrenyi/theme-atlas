---
import type { PaletteColor } from '../data/types';
import { t, type Locale } from '../i18n';

interface Props {
  palette: PaletteColor[];
  /** Height / density of the strip. */
  variant?: 'card' | 'hero' | 'detail';
  class?: string;
  lang: Locale;
}

const { palette, variant = 'card', class: className = '', lang } = Astro.props;
const summary = palette.map((color) => color.name + ' ' + color.hex).join(t(lang, 'palette.stripSeparator'));
---

<div class:list={['strip-wrap', className]}>
  <div
    class:list={['strip', 'strip--' + variant]}
    role="group"
    aria-label={t(lang, 'palette.stripLabel', { summary })}
  >
    {
      palette.map((color) => (
        <button
          type="button"
          class="strip__swatch"
          style={'--swatch:' + color.hex}
          data-label={color.name + ' · ' + color.hex}
          data-palette-swatch
          aria-label={t(lang, 'palette.swatchLabel', { name: color.name, hex: color.hex })}
          aria-expanded="false"
        />
      ))
    }
  </div>
</div>

<script>
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-palette-swatch]'));

  function closeSwatches(except?: HTMLButtonElement) {
    swatches.forEach((swatch) => {
      if (swatch === except) return;
      swatch.setAttribute('aria-expanded', 'false');
    });
  }

  swatches.forEach((swatch) => {
    swatch.addEventListener('click', (event) => {
      event.stopPropagation();
      const expanded = swatch.getAttribute('aria-expanded') === 'true';
      closeSwatches(swatch);
      swatch.setAttribute('aria-expanded', String(!expanded));
    });
  });

  document.addEventListener('click', () => closeSwatches());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSwatches();
  });
</script>

<style>
  .strip {
    display: flex;
    width: 100%;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .strip__swatch {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    appearance: none;
    border: 0;
    padding: 0;
    background: var(--swatch);
    cursor: help;
  }

  .strip__swatch:first-child {
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .strip__swatch:last-child {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .strip--card .strip__swatch {
    height: 76px;
  }

  .strip--hero .strip__swatch {
    height: clamp(84px, 10vw, 132px);
  }

  .strip--detail .strip__swatch {
    height: 64px;
  }

  .strip__swatch::after {
    content: attr(data-label);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translate(-50%, 4px);
    padding: 5px 9px;
    background: var(--panel-3);
    color: var(--text);
    border: 1px solid var(--orbit);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease);
    z-index: 5;
  }

  .strip__swatch:hover::after,
  .strip__swatch:focus-visible::after,
  .strip__swatch[aria-expanded='true']::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .strip__swatch:focus-visible {
    outline-offset: -3px;
    z-index: 2;
  }
</style>
