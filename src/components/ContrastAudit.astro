---
import type { Theme } from '../data/types';
import { auditContrast } from '../lib/color';
import { t, type Locale, type UiKey } from '../i18n';

interface Props {
  theme: Theme;
  lang: Locale;
}

const { theme, lang } = Astro.props;
const checks = auditContrast(theme);
const failed = checks.filter((c) => !c.pass);
---

<section class="audit" aria-labelledby="audit-heading">
  <div class="audit__head">
    <h2 id="audit-heading" class="audit__heading">{t(lang, 'audit.heading')}</h2>
    <p class="audit__sub mono">
      {
        failed.length === 0
          ? t(lang, 'audit.pass')
          : t(lang, 'audit.fail', { count: failed.length })
      }
    </p>
  </div>

  <table class="audit__table">
    <caption class="sr-only">{t(lang, 'audit.caption', { title: theme.title })}</caption>
    <thead>
      <tr>
        <th scope="col">{t(lang, 'audit.colPair')}</th>
        <th scope="col">{t(lang, 'audit.colRatio')}</th>
        <th scope="col">{t(lang, 'audit.colTarget')}</th>
        <th scope="col">{t(lang, 'audit.colResult')}</th>
      </tr>
    </thead>
    <tbody>
      {
        checks.map((check) => (
          <tr>
            <th scope="row">{t(lang, ('audit.pair.' + check.key) as UiKey)}</th>
            <td class="mono">{check.ratio.toFixed(2)}:1</td>
            <td class="mono">{check.threshold}:1</td>
            <td>
              <span class:list={['audit__badge', check.pass ? 'is-pass' : 'is-fail']}>
                {check.pass ? t(lang, 'audit.passLabel') : t(lang, 'audit.failLabel')}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="audit__note">{t(lang, 'audit.note')}</p>
</section>

<style>
  .audit {
    padding-top: 22px;
    margin-top: 22px;
    border-top: 1px solid var(--orbit-faint);
  }

  .audit__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .audit__heading {
    font-size: var(--step-1);
  }

  .audit__sub {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--glow);
  }

  .audit__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .audit__table th,
  .audit__table td {
    text-align: left;
    padding: 9px 0;
    border-bottom: 1px solid var(--orbit-faint);
    font-weight: 400;
  }

  .audit__table thead th {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 400;
  }

  .audit__table tbody th {
    color: var(--text-2);
  }

  .audit__table td.mono {
    font-size: 0.74rem;
    color: var(--text-2);
  }

  .audit__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    border: 1px solid var(--orbit-dim);
    border-radius: 2px;
    padding: 2px 7px;
  }

  .audit__badge.is-pass {
    color: var(--glow);
    border-color: color-mix(in srgb, var(--glow) 45%, transparent);
  }

  .audit__badge.is-fail {
    color: var(--alert);
    border-color: color-mix(in srgb, var(--alert) 45%, transparent);
  }

  .audit__note {
    margin-top: 14px;
    font-size: 0.74rem;
    line-height: 1.7;
    color: var(--text-3);
  }
</style>

