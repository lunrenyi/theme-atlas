---
import type { PaletteRole, Theme } from '../data/types';
import {
  codexDiffAdded,
  codexDiffContext,
  codexDiffRemoved,
  codexSyntaxExample,
  nousCodexDiffAdded,
  nousCodexDiffContext,
  nousCodexDiffRemoved,
  nousCodexSyntaxExample,
} from '../data/syntaxExamples';
import { paletteMap } from '../lib/color';
import { t, type Locale } from '../i18n';
import PreviewColorLegend from './PreviewColorLegend.astro';
import SyntaxTokens from './SyntaxTokens.astro';
import TerminalShell from './TerminalShell.astro';

interface Props {
  theme: Theme;
  lang: Locale;
}

const { theme, lang } = Astro.props;
const design = theme.previewDesign.codex;
const map = paletteMap(theme);
const contentId = 'codex-preview-' + theme.slug;
const examples = {
  default: {
    code: codexSyntaxExample,
    context: codexDiffContext,
    removed: codexDiffRemoved,
    added: codexDiffAdded,
  },
  'nous-deduction': {
    code: nousCodexSyntaxExample,
    context: nousCodexDiffContext,
    removed: nousCodexDiffRemoved,
    added: nousCodexDiffAdded,
  },
};
const example = examples[design.example ?? 'default'];
const fileName = design.fileName ?? 'src/theme.ts';
const dialogue = design.dialogue ?? {
  user: 'Refactor the theme resolver to use semantic roles.',
  assistant: 'I will update the resolver and preserve the existing palette schema.',
  status: 'Inspecting src/theme.ts · 42ms',
  input: 'Ask Codex to continue...',
};

const cssRole = (role: PaletteRole) => 'var(--t-' + (role === 'onAccent' ? 'on-accent' : role) + ')';
const tokenVars = Object.entries(theme.syntax)
  .map(([token, hex]) => `--syntax-${token}:${hex};`)
  .join('');
const vars = tokenVars +
  `--codex-added:${cssRole(design.diffAdded)};` +
  `--codex-removed:${cssRole(design.diffRemoved)};` +
  `--codex-prompt:${cssRole(design.promptAccent)};` +
  `--codex-divider:${cssRole(design.divider)};`;
const removedFallback = !map.flare && design.diffRemoved === 'flare' ? 'muted' : design.diffRemoved;
---

<div
  class="codex-preview"
  data-codex-preview
  data-codex-layout={design.layout}
  data-preview-role-root
  data-theme={theme.slug}
  style={vars + '--codex-removed-effective:' + cssRole(removedFallback) + ';'}
>
  <TerminalShell
    theme={theme}
    kind="codex"
    title="codex - ~/theme-atlas"
    subtitle="static preview"
    ariaLabel={`Static Codex CLI preview for ${theme.slug}`}
  >
    <div id={contentId} class="codex" data-prompt-role="bg">
      <div class="codex__context" data-prompt-role="surface">
        <span class="codex__badge" data-prompt-role="accent onAccent">Codex</span>
        <span data-prompt-role="text">~/theme-atlas</span>
        <span data-prompt-role="muted">workspace: theme-atlas</span>
      </div>

      <div class="codex__flow">
        <section class="codex__turn codex__turn--user" data-prompt-role="surface border">
          <p class="codex__label" data-prompt-role="muted">You</p>
          <p data-prompt-role="text">{dialogue.user}</p>
        </section>

        <section class="codex__turn" data-prompt-role="surface border">
          <p class="codex__label" data-prompt-role="accent">Codex</p>
          <p data-prompt-role="text">{dialogue.assistant}</p>
          <p class="codex__status" data-prompt-role="muted">
            <span class="codex__status-dot" data-prompt-role="accent" aria-hidden="true"></span>
            {dialogue.status}
          </p>
          {dialogue.conclusion && <p class="codex__conclusion" data-prompt-role="text">{dialogue.conclusion}</p>}
        </section>

        <div class="codex__workbench">
          <section class="codex__code" aria-label="Code preview" data-prompt-role="surface border">
            <div class="codex__panel-head" data-prompt-role="muted">
              <span data-prompt-role="text">{fileName}</span>
              <span>typescript</span>
            </div>
            <pre><code>{example.code.map((line) => (
              <span class="codex__code-line"><SyntaxTokens tokens={line} /></span>
            ))}</code></pre>
          </section>

          <section class="codex__diff" aria-label="File diff" data-prompt-role="surface border">
            <div class="codex__panel-head" data-prompt-role="muted">
              <span data-prompt-role="text">{fileName}</span>
              <span>
                <b data-prompt-role="accent">+1</b>
                <b data-prompt-role={map.flare ? 'flare' : 'muted'}>-1</b>
              </span>
            </div>
            <div class="codex__diff-line" data-prompt-role="muted">
              <span class="codex__diff-marker" aria-hidden="true"></span>
              <span><SyntaxTokens tokens={example.context} /></span>
            </div>
            <div class="codex__diff-line codex__diff-line--remove">
              <span class="codex__diff-marker" data-prompt-role={map.flare ? 'flare' : 'muted'}>-</span>
              <span><SyntaxTokens tokens={example.removed} /></span>
            </div>
            <div class="codex__diff-line codex__diff-line--add">
              <span class="codex__diff-marker" data-prompt-role="accent">+</span>
              <span><SyntaxTokens tokens={example.added} /></span>
            </div>
          </section>
        </div>
      </div>

      <div class="codex__input" data-prompt-role="surface border">
        <span class="codex__prompt" data-prompt-role="accent">›</span>
        <span data-prompt-role="text">{dialogue.input ?? 'Ask Codex to continue...'}</span>
        <span class="codex__cursor" aria-hidden="true"></span>
        <span class="codex__hint" data-prompt-role="muted">Enter to send · Shift+Enter for newline</span>
      </div>
    </div>
  </TerminalShell>

  <p class="tool-preview__note">{t(lang, 'preview.codexNote')}</p>
  <PreviewColorLegend theme={theme} lang={lang} contentId={contentId} />
</div>

<style>
  .codex-preview {
    min-width: 0;
  }

  .codex {
    min-width: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: clamp(0.7rem, 2vw, 0.8rem);
    line-height: 1.65;
  }

  .codex__context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 12px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--codex-divider);
    background: var(--t-surface);
  }

  .codex__badge {
    padding: 1px 6px;
    background: var(--codex-prompt);
    color: var(--t-on-accent);
    font-weight: 700;
  }

  .codex__flow {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
  }

  .codex__turn {
    min-width: 0;
    padding: 9px 10px;
    border-left: 2px solid var(--codex-divider);
  }

  .codex__turn--user {
    margin-left: clamp(0px, 4vw, 38px);
  }

  .codex__label {
    margin-bottom: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .codex__status {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 7px;
  }

  .codex__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--t-accent);
  }

  .codex__conclusion {
    margin-top: 5px;
    color: var(--t-text);
  }

  .codex__workbench {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .codex__code,
  .codex__diff {
    min-width: 0;
    border: 1px solid var(--codex-divider);
    background: var(--t-surface);
  }

  .codex__code {
    background: var(--t-bg);
  }

  .codex__panel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 5px 12px;
    padding: 5px 8px;
    border-bottom: 1px solid var(--codex-divider);
    font-size: 0.68rem;
    color: var(--t-text);
    background: var(--t-surface);
  }

  .codex__panel-head b {
    font-weight: 700;
  }

  .codex__code pre {
    margin: 0;
    padding: 9px 10px;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .codex__code code {
    font: inherit;
    color: var(--t-text);
  }

  .codex__code-line {
    display: block;
    min-height: 1.65em;
  }

  .codex__diff-line {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 4px;
    padding: 3px 8px;
    border-top: 1px solid color-mix(in srgb, var(--codex-divider) 66%, transparent);
    background: var(--t-bg);
    color: var(--t-text);
    overflow-wrap: anywhere;
  }

  .codex__diff-marker {
    color: var(--codex-divider);
    font-weight: 700;
    text-align: center;
  }

  .codex__diff-line--add {
    border-left: 3px solid var(--codex-added);
    box-shadow: inset 18px 0 0 color-mix(in srgb, var(--codex-added) 10%, transparent);
  }

  .codex__diff-line--remove {
    border-left: 3px solid var(--codex-removed-effective);
    box-shadow: inset 18px 0 0 color-mix(in srgb, var(--codex-removed-effective) 10%, transparent);
  }

  .codex__input {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    min-width: 0;
    margin: 0 12px 12px;
    padding: 8px 9px;
    border: 1px solid var(--codex-divider);
  }

  .codex__prompt {
    font-size: 1rem;
    font-weight: 700;
  }

  .codex__cursor {
    width: 0.55em;
    height: 1.05em;
    border-left: 1px solid var(--t-text);
  }

  .codex__hint {
    margin-left: auto;
    font-size: 0.6rem;
  }

  .codex-preview[data-codex-layout='split'] .codex__workbench {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tool-preview__note {
    margin-top: 9px;
    color: var(--text-3);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  @media (max-width: 520px) {
    .codex {
      font-size: 0.67rem;
    }

    .codex__flow {
      padding: 9px;
    }

    .codex__turn--user {
      margin-left: 0;
    }

    .codex-preview[data-codex-layout='split'] .codex__workbench {
      grid-template-columns: 1fr;
    }

    .codex__hint {
      flex-basis: 100%;
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .codex-preview * {
      transition: none;
    }
  }
</style>
